      <a id="btnDownload" class="btn-download" onclick="downloadDB(event)">📥 Download Database</a>
      <span style="font-size:0.75em;color:var(--gray-400)">Admin only — downloads full SQLite database</span>
    </div>
    <div class="table-wrap" id="backupList"><div class="loading">Loading...</div></div>
  </div>
</div>

<script>
var token = localStorage.getItem('ward25_token') || '';
var currentUser = null;
var pollOrder = [];  // poll numbers in sorted order for color coding
var pollColors = ['green','yellow','blue','orange','purple'];
var _pollData = [];           // cached poll data for sorting
var _pollApiData = null;      // cached API response for without_poll etc.
var _pollSortBy = 'num';      // current sort field
var _pollSortDir = 'asc';     // asc or desc

function getPollColorIdx(pollNum) {
  return pollOrder.indexOf(String(pollNum));
}

function getPollColorName(pollNum) {
  var idx = getPollColorIdx(pollNum);
  if (idx < 0) return '';
  return pollColors[idx % pollColors.length];
}

function getPollColorClass(pollNum) {
  var idx = getPollColorIdx(pollNum);
  if (idx < 0) return '';
  return 'poll-' + pollColors[idx % pollColors.length];
}

var _pollMaxTotal = 0;

function renderPollTable() {
  var tbody = document.getElementById('pollStatsBody');
  if (!tbody || !_pollData.length) return;
  var polls = _pollData;
  
  // Compute max total for bar widths
  _pollMaxTotal = Math.max.apply(null, polls.map(function(p){return p.total;}));
  
  // Sort
  var sorted = polls.slice();
  var dir = _pollSortDir === 'asc' ? 1 : -1;
  sorted.sort(function(a, b) {
    var va, vb;
    if (_pollSortBy === 'num') {
      va = parseInt(a.poll, 10);
      vb = parseInt(b.poll, 10);
    } else if (_pollSortBy === 'color') {
      va = getPollColorIdx(a.poll);
      vb = getPollColorIdx(b.poll);
      if (va === vb) { va = parseInt(a.poll, 10); vb = parseInt(b.poll, 10); }
    } else if (_pollSortBy === 'total') {
      va = a.total; vb = b.total;
    } else if (_pollSortBy === 'supporters') {
      va = a.supporters || 0; vb = b.supporters || 0;
    } else if (_pollSortBy === 'signs_req') {
      va = a.signs_requested || 0; vb = b.signs_requested || 0;
    } else if (_pollSortBy === 'signs_decl') {
      va = a.signs_declined || 0; vb = b.signs_declined || 0;
    }
    if (va < vb) return -1 * dir;
    if (va > vb) return 1 * dir;
    return 0;
  });
  
  var barW = function(p) { return Math.round((p.total / _pollMaxTotal) * 100); };
  var colorClass = function(p) { return getPollColorClass(p.poll); };
  
  tbody.innerHTML = sorted.map(function(p){
    return '<tr class="clickable-row '+colorClass(p)+'" data-drill="poll" data-value="'+p.poll+'" title="Click to see all Poll '+p.poll+' records">'+
      '<td><strong><a href="/poll_maps/normalized/poll_'+p.poll+'.png" target="_blank" style="color:inherit;text-decoration:none" title="View map" onclick="event.stopPropagation()">🗺 '+p.poll+'</a></strong></td>'+
      '<td>'+p.total+' <span style="font-size:0.7em;opacity:0.7">('+barW(p)+'%)</span></td>'+
      '<td>'+(p.supporters||0)+'</td>'+
      '<td>'+(p.signs_requested||0)+'</td>'+
      '<td>'+(p.signs_declined||0)+'</td>'+
      '</tr>';
  }).join('');
  
  // Add totals row
  var tTotal=0, tSupporters=0, tSignsR=0, tSignsD=0;
  polls.forEach(function(p){
    tTotal += p.total||0;
    tSupporters += p.supporters||0;
    tSignsR += p.signs_requested||0;
    tSignsD += p.signs_declined||0;
  });
  tbody.innerHTML += '<tr style="border-top:2px solid var(--gray-300);font-weight:700;background:var(--gray-50)">'+
    '<td>TOTAL ('+polls.length+' polls)</td>'+
    '<td>'+tTotal+'</td><td>'+tSupporters+'</td><td>'+tSignsR+'</td><td>'+tSignsD+'</td></tr>';
  if (_pollApiData && _pollApiData.without_poll > 0) {
    tbody.innerHTML += '<tr style="color:var(--amber);font-size:0.85em"><td>⚠ No poll assigned</td><td>'+_pollApiData.without_poll+'</td><td colspan="3">These records need address matching</td></tr>';
  }
}

function sortPollTable(field) {
  if (_pollSortBy === field) {
    _pollSortDir = _pollSortDir === 'asc' ? 'desc' : 'asc';
  } else {
    _pollSortBy = field;
    _pollSortDir = 'asc';
  }
  // Update sort indicator
  document.getElementById('pollSortIndicator').textContent = (_pollSortDir === 'asc' ? 'asc ↑' : 'desc ↓');
  // Update active button using mapped IDs
  var btnMap = {num:'Num', color:'Color', total:'Total', supporters:'Supporters', signs_req:'SignsReq', signs_decl:'SignsDecl'};
  document.querySelectorAll('.sort-btn').forEach(function(b){ b.style.background = 'white'; b.style.fontWeight = 'normal'; });
  var activeBtn = document.getElementById('sortPoll' + btnMap[field]);
  if (activeBtn) { activeBtn.style.background = 'var(--gray-100)'; activeBtn.style.fontWeight = '700'; }
  // Update header icons using mapped IDs
  var iconMap = {num:'Num', total:'Total', supporters:'Supporters', signs_req:'SignsReq', signs_decl:'SignsDecl'};
  Object.keys(iconMap).forEach(function(f){
    var icon = document.getElementById('pollSort' + iconMap[f] + 'Icon');
    if (icon) icon.textContent = (f === _pollSortBy ? (_pollSortDir === 'asc' ? '▲' : '▼') : '');
  });
  renderPollTable();
}

function getPollBadgeClass(pollNum) {
  var idx = pollOrder.indexOf(String(pollNum));
  if (idx < 0) return '';
  return 'poll-badge-' + pollColors[idx % pollColors.length];
}

function getOrdinal(n) {
  var s = ['th','st','nd','rd'];
  var v = n % 100;
  return s[(v-20)%10] || s[v] || s[0];
}

// Try auto-login
if (token) {
  fetch('/api/auth/me', {headers:{'Authorization':'Bearer '+token}})
    .then(function(r){ return r.ok ? r.json() : null; })
    .then(function(d){
      if (d && d.user) {
        currentUser = d.user;
        showDashboard();
      } else {
        token = ''; localStorage.removeItem('ward25_token');
      }
    });
}

function doLogin() {
  var u = document.getElementById('loginUser').value.trim();
  var p = document.getElementById('loginPass').value;
  if (!u || !p) return;
  var err = document.getElementById('loginError');
  err.style.display = 'none';
  fetch('/api/auth/login', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({username:u, password:p})
  }).then(function(r){ return r.json(); })
    .then(function(d){
      if (d.token) {
        token = d.token;
        currentUser = d.user;
        localStorage.setItem('ward25_token', token);
        showDashboard();
      } else {
        err.textContent = '❌ ' + (d.error || 'Login failed');
        err.style.display = 'block';
      }
    }).catch(function(){ err.textContent = '❌ Network error'; err.style.display = 'block'; });
}

function doLogout() {
  if (token) {
    fetch('/api/auth/logout', {method:'POST', headers:{'Authorization':'Bearer '+token}});
  }
  token = ''; currentUser = null;
  localStorage.removeItem('ward25_token');
  document.getElementById('dashboard').style.display = 'none';
  document.getElementById('loginGate').style.display = 'flex';
  document.getElementById('btnLogout').style.display = 'none';
  document.getElementById('userDisplay').style.display = 'none';
  document.getElementById('loginPass').value = '';
  document.getElementById('loginUser').focus();
}

function showDashboard() {
  document.getElementById('loginGate').style.display = 'none';
  document.getElementById('dashboard').style.display = 'block';
  document.getElementById('btnLogout').style.display = 'inline-block';
  document.getElementById('userDisplay').style.display = 'inline';
  document.getElementById('userDisplay').textContent = '👤 ' + currentUser.display_name + ' (' + currentUser.role + ')';
  // Show user management for admins
  if (currentUser.role === 'admin') {
    document.getElementById('usersSection').style.display = 'block';
    document.getElementById('usersTableWrap').style.display = 'block';
    document.getElementById('agentsSection').style.display = 'block';
    document.getElementById('agentsTableWrap').style.display = 'block';
    loadUsers();
    loadAgents();
  }
  loadDashboard();
  // Pre-fetch task count
  fetch('/api/admin/tasks?status=open').then(function(r){return r.json()}).then(function(d){
    document.getElementById('tasksCount').textContent = '(' + d.count + ')';
  }).catch(function(){});
}

function authHeaders() {
  return {headers:{'Authorization':'Bearer '+token}};
}

async function loadDashboard() {
  try {
    var r = await fetch('/api/admin/today');
    var d = await r.json();
    document.getElementById('stat-total').textContent = d.total_records.toLocaleString();
    document.getElementById('stat-today').textContent = d.today_changes;
    document.getElementById('stat-touched').textContent = d.today_touched;
    document.getElementById('stat-week').textContent = d.week_changes;
    document.getElementById('stat-dbsize').textContent = formatSize(d.db_size);

    if (d.backups && d.backups.length > 0) {
      document.getElementById('stat-backup').textContent = timeAgo(d.backups[0].mtime * 1000);
    } else {
      document.getElementById('stat-backup').textContent = 'None';
    }

    var bl = document.getElementById('backupList');
    if (d.backups && d.backups.length > 0) {
      bl.innerHTML = d.backups.map(function(b) {
        return '<div class="backup-item"><span class="backup-name">📁 '+esc(b.name)+'</span><span class="backup-info">'+formatSize(b.size)+' · '+timeAgo(b.mtime*1000)+'</span></div>';
      }).join('');
    } else {
      bl.innerHTML = '<div style="text-align:center;padding:20px;color:var(--gray-400)">No backups yet</div>';
    }
  } catch(e) { console.error(e); }

  loadChart('week');
  loadTeamDashboard();
  loadCanvasserStats('daily');
  loadPollStats();
  loadSupportTrends(7);
  loadCanvassAssignments();
  loadChanges('today');
}

// ── Team Dashboard ──
async function loadTeamDashboard() {
  try {
    var r = await fetch('/api/admin/team');
    var d = await r.json();
    document.getElementById('team-supporters').textContent = d.supporters.toLocaleString();
    document.getElementById('team-surveys').textContent = d.surveys_completed;
    document.getElementById('team-signs').textContent = d.signs_completed;
    document.getElementById('team-signs-pending').textContent = d.signs_pending;
    document.getElementById('team-touched').textContent = d.touched_today;

    // Support level breakdown with bar
    var maxLvl = d.levels && d.levels.length > 0 ? Math.max.apply(null, d.levels.map(function(l){return l.cnt;})) : 1;
    var lvlBody = document.getElementById('teamLevels');
    if (d.levels && d.levels.length > 0) {
      lvlBody.innerHTML = d.levels.map(function(l){
        var pct = Math.round((l.cnt / d.total) * 100);
        var barW = Math.round((l.cnt / maxLvl) * 100);
        var sl = l.support_level||'Unknown';
        return '<tr class="clickable-row" data-drill="level" data-value="'+esc(sl)+'" title="Click to see all '+esc(sl)+' records">'+
          '<td>'+esc(sl)+'</td><td><strong>'+l.cnt.toLocaleString()+'</strong> ('+pct+'%)</td>'+
          '<td><div style="background:var(--red);height:18px;width:'+barW+'%;border-radius:3px;min-width:2px"></div></td></tr>';
      }).join('');
    }

    // User activity
    var actBody = document.getElementById('teamActivity');
    if (d.user_activity && d.user_activity.length > 0) {
      actBody.innerHTML = d.user_activity.map(function(u){
        var name = u.display_name||u.username||'System';
        return '<tr class="clickable-row" data-drill="user" data-value="'+esc(u.username||'')+'" title="Click to see changes by '+esc(name)+'">'+
          '<td>'+esc(name)+'</td><td><strong>'+u.changes+'</strong></td></tr>';
      }).join('');
    } else {
      actBody.innerHTML = '<tr><td colspan="2" style="text-align:center;color:var(--gray-400)">No user activity yet</td></tr>';
    }

    // ── Update export button labels with real counts ──
    var lvlMap = {};
    if (d.levels) d.levels.forEach(function(l){ lvlMap[(l.support_level||'').toLowerCase()] = l.cnt; });
    var supCnt = d.supporters || lvlMap['supporter'] || 0;
    var neuCnt = lvlMap['neutral'] || 0;
    var nonCnt = lvlMap['non-supporter'] || lvlMap['non supporter'] || 0;
    window._exportCounts = { supporter: supCnt, neutral: neuCnt, nonsupporter: nonCnt, declined: d.signs_pending || 0, requested: d.signs_completed || 0 };
    var chips = document.querySelectorAll('.btn-export-chip');
    if (chips.length >= 5) {
      if (chips[0].textContent.indexOf('(') === -1) chips[0].textContent += ' (' + supCnt.toLocaleString() + ')';
      if (chips[1].textContent.indexOf('(') === -1) chips[1].textContent += ' (' + neuCnt.toLocaleString() + ')';
      if (chips[2].textContent.indexOf('(') === -1) chips[2].textContent += ' (' + nonCnt.toLocaleString() + ')';
      if (chips[3].textContent.indexOf('(') === -1) chips[3].textContent += ' (' + (d.signs_pending||0).toLocaleString() + ')';
      if (chips[4].textContent.indexOf('(') === -1) chips[4].textContent += ' (' + (d.signs_completed||0).toLocaleString() + ')';
    }
  } catch(e) { console.error(e); }
}

// ── Poll Stats ──
async function loadPollStats() {
  try {
    var r = await fetch('/api/polls');
    var d = await r.json();
    var tbody = document.getElementById('pollStatsBody');
    var pollSelect = document.getElementById('adminPollFilter');
    
    // Populate poll filter dropdown
    pollSelect.innerHTML = '<option value="">All Polls</option>';
    var polls = d.polls || [];
    polls.forEach(function(p) {
      pollSelect.innerHTML += '<option value="'+p.poll+'">Poll '+p.poll+' ('+p.total+')</option>';
    });
    
    // Cache poll counts for exports
    
    if (polls.length > 0) {
      // Set global poll order for color coding
      pollOrder = polls.map(function(p){ return p.poll; });
      
      // ── Render rank summary ──
      var rankColors = {green:'#16a34a', yellow:'#d97706', blue:'#2563eb', orange:'#ea580c', purple:'#7c3aed'};
      // ── Render poll color legend dynamically ──
      var colorLegend = document.getElementById('pollColorLegend');
      if (colorLegend && d.rank_summary) {
        var colorNames = {'green':'Green','yellow':'Yellow','blue':'Blue','orange':'Orange','purple':'Purple'};
        colorLegend.innerHTML = '<span style="font-weight:600;margin-right:4px">🎨 Poll Colors:</span>' +
          d.rank_summary.map(function(r) {
            var show = r.polls.slice(0,4).join(', ') + (r.polls.length > 4 ? '...' : '');
            return '<span style="background:'+rankColors[r.color]+';color:white;padding:2px 10px;border-radius:10px;font-weight:600;white-space:nowrap">'+colorNames[r.color]+'</span>' +
              ' <span style="font-size:0.85em">(' + show + ')</span>';
          }).join(' ') + ' <span style="margin-left:6px">(repeats every 5)</span>';
      }
      
      // ── Render canvass poll legend ──
      var canvassLegend = document.getElementById('canvassPollLegend');
      if (canvassLegend && d.rank_summary) {
        canvassLegend.innerHTML = '<span style="font-weight:600">🎨 Polls:</span> ' +
          d.rank_summary.map(function(r) {
            return '<span style="background:'+rankColors[r.color]+';color:white;padding:1px 8px;border-radius:8px;font-weight:600">'+r.polls[0]+'</span>';
          }).join(' ') + ' <span>(every 5)</span>';
      }
      
      var maxTotal = Math.max.apply(null, polls.map(function(p){return p.total;}));
      _pollData = polls;
      _pollApiData = d;
      renderPollTable();
    } else {
      tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--gray-400)">No poll data yet</td></tr>';
    }
    
    // Build poll map reference grid
    var grid = document.getElementById('pollMapGrid');
    if (grid && polls.length > 0) {
      grid.innerHTML = polls.map(function(p){
        var colorClass = getPollColorClass(p.poll);
        return '<a href="/poll_maps/normalized/poll_'+p.poll+'.png" target="_blank" class="'+colorClass+'" style="display:block;border:2px solid transparent;border-radius:8px;padding:6px;text-align:center;text-decoration:none;transition:transform 0.15s" title="Poll '+p.poll+' - '+p.total+' records" onmouseover="this.style.transform=\'scale(1.05)\'" onmouseout="this.style.transform=\'scale(1)\'">'+
          '<img src="/poll_maps/normalized/poll_'+p.poll+'.png" alt="Poll '+p.poll+' map" style="width:100%;height:80px;object-fit:cover;border-radius:4px" loading="lazy">'+
          '<div style="font-size:0.7em;font-weight:700;margin-top:4px">Poll '+p.poll+'</div>'+
          '<div style="font-size:0.6em;opacity:0.7">'+p.total+' records</div>'+
          '</a>';
      }).join('');
    }
    
    // Populate canvass poll dropdown
    var canvassSelect = document.getElementById('canvassPollSelect');
    canvassSelect.innerHTML = '<option value="">— Select Poll —</option>';
    polls.forEach(function(p){
      canvassSelect.innerHTML += '<option value="'+p.poll+'">Poll '+p.poll+' ('+p.total+' records)</option>';
    });
  } catch(e) { console.error(e); }
}

// ── Canvasser Leaderboard ──
var csCurrentMode = 'daily';
var csCurrentSort = 'changes';  // default sort by Changes
var csSortDesc = true;          // descending (highest first)
var csCachedUsers = [];         // raw user data from API
var csCachedMode = '';          // which mode the cache is for

async function loadCanvasserStats(mode) {
  csCurrentMode = mode || 'daily';
  var today = new Date().toISOString().slice(0,10);

  // Update toggle buttons
  ['csDaily','csWeek','csMonth','csTotal'].forEach(function(id){
    document.getElementById(id).classList.remove('active');
  });
  var btnMap = {daily:'csDaily', week:'csWeek', month:'csMonth', total:'csTotal'};
  if (btnMap[csCurrentMode]) document.getElementById(btnMap[csCurrentMode]).classList.add('active');

  var start, end, label;
  if (csCurrentMode === 'daily') {
    start = today; end = today; label = 'Today';
  } else if (csCurrentMode === 'week') {
    var d = new Date();
    var dayOfWeek = d.getDay() || 7; // Sunday=7
    d.setDate(d.getDate() - dayOfWeek + 1);
    start = d.toISOString().slice(0,10);
    d.setDate(d.getDate() + 6);
    end = d.toISOString().slice(0,10);
    label = 'This Week';
  } else if (csCurrentMode === 'month') {
    var d = new Date();
    start = d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-01';
    end = today;
    label = 'This Month';
  } else if (csCurrentMode === 'total') {
    start = '2000-01-01'; end = today; label = 'All Time';
  } else {
    start = document.getElementById('csStart').value || today;
    end = document.getElementById('csEnd').value || today;
    label = start + ' – ' + end;
  }

  document.getElementById('csRangeLabel').textContent = label;

  var tbody = document.getElementById('canvasserStatsBody');
  tbody.innerHTML = '<tr><td colspan="6" class="loading">Loading...</td></tr>';

  try {
    var url = '/api/admin/canvasser-stats?start='+encodeURIComponent(start)+'&end='+encodeURIComponent(end);
    var r = await fetch(url);
    var d = await r.json();
    var users = d.users || [];

    // Cache data
    csCachedUsers = users;
    csCachedMode = csCurrentMode;

    // Sort by default (changes desc) then render
    csCurrentSort = 'changes'; csSortDesc = true;
    sortAndRenderLeaderboard();
  } catch(e) {
    console.error(e);
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--red)">Error loading stats</td></tr>';
  }
}

function getStatForMode(u) {
  if (csCurrentMode === 'daily') return u.daily;
  if (csCurrentMode === 'total') return u.total;
  return u.range;
}

function sortCanvasserStats(field) {
  if (csCurrentSort === field) {
    csSortDesc = !csSortDesc;  // toggle direction
  } else {
    csCurrentSort = field;
    csSortDesc = true;  // default descending for numbers, ascending for name
    if (field === 'name') csSortDesc = false;
  }
  sortAndRenderLeaderboard();
}

function filterCanvasserStats() {
  sortAndRenderLeaderboard();
}

function sortAndRenderLeaderboard() {
  var users = csCachedUsers.slice();
  var search = (document.getElementById('csSearch').value || '').toLowerCase();

  // Filter
  if (search) {
    users = users.filter(function(u){
      var name = (u.display_name || u.username || '').toLowerCase();
      return name.indexOf(search) !== -1;
    });
  }

  // Sort
  users.sort(function(a, b){
    var sa = getStatForMode(a);
    var sb = getStatForMode(b);
    var cmp = 0;

    if (csCurrentSort === 'name') {
      var na = (a.display_name || a.username || '').toLowerCase();
      var nb = (b.display_name || b.username || '').toLowerCase();
      cmp = na < nb ? -1 : na > nb ? 1 : 0;
    } else if (csCurrentSort === 'changes') {
      cmp = (sa.changes||0) - (sb.changes||0);
    } else if (csCurrentSort === 'supporters') {
      cmp = (sa.supporters||0) - (sb.supporters||0);
    } else if (csCurrentSort === 'signs') {
      cmp = (sa.signs_requested||0) - (sb.signs_requested||0);
    } else if (csCurrentSort === 'surveys') {
      cmp = (sa.surveys||0) - (sb.surveys||0);
    }
    return csSortDesc ? -cmp : cmp;
  });

  // Render
  renderLeaderboardTable(users);
}

function renderLeaderboardTable(users) {
  var tbody = document.getElementById('canvasserStatsBody');

  // Update sort arrows
  ['name','changes','supporters','signs','surveys'].forEach(function(f){
    var arrow = document.getElementById('sortArrow_'+f);
    if (!arrow) return;
    arrow.classList.remove('asc','desc','active');
    if (f === csCurrentSort) {
      arrow.classList.add('active');
      arrow.classList.add(csSortDesc ? 'desc' : 'asc');
    }
  });

  if (users.length === 0) {
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--gray-400);padding:20px">No canvassers match</td></tr>';
    return;
  }

  var rows = users.map(function(u, idx){
    var stats = getStatForMode(u);
    var name = u.display_name || u.username;

    // Rank with medals
    var rankHtml;
    if (idx === 0) rankHtml = '🥇';
    else if (idx === 1) rankHtml = '🥈';
    else if (idx === 2) rankHtml = '🥉';
    else rankHtml = String(idx + 1);

    // Row class
    var rowClass = '';
    if (idx === 0) rowClass = 'leader-row-gold';
    else if (idx === 1) rowClass = 'leader-row-silver';
    else if (idx === 2) rowClass = 'leader-row-bronze';

    return '<tr class="'+rowClass+'">'+
      '<td class="leader-rank">'+rankHtml+'</td>'+
      '<td><strong>'+esc(name)+'</strong></td>'+
      '<td style="text-align:right;font-weight:600">'+(stats.changes||0)+'</td>'+
      '<td style="text-align:right">'+(stats.supporters||0)+'</td>'+
      '<td style="text-align:right">'+(stats.signs_requested||0)+'</td>'+
      '<td style="text-align:right">'+(stats.surveys||0)+'</td>'+
      '</tr>';
  }).join('');

  // Add totals row
  var tChanges=0, tSupporters=0, tSigns=0, tSurveys=0;
  users.forEach(function(u){
    var stats = getStatForMode(u);
    tChanges += stats.changes||0;
    tSupporters += stats.supporters||0;
    tSigns += stats.signs_requested||0;
    tSurveys += stats.surveys||0;
  });

  rows += '<tr style="border-top:2px solid var(--gray-300);font-weight:700;background:var(--gray-50)">'+
    '<td></td>'+
    '<td>TOTAL ('+users.length+' canvassers)</td>'+
    '<td style="text-align:right">'+tChanges+'</td>'+
    '<td style="text-align:right">'+tSupporters+'</td>'+
    '<td style="text-align:right">'+tSigns+'</td>'+
    '<td style="text-align:right">'+tSurveys+'</td>'+
    '</tr>';

  tbody.innerHTML = rows;
}

async function downloadTeamDashboard(e) {
  e.preventDefault();
  var a = document.createElement('a');
  a.href = '/api/admin/team/export';
  a.download = 'Ward25_team_dashboard.csv';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
}

// ── Chart ──
var chartData = [];
var chartMode = 'week';
var chartDays = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

async function loadChart(mode) {
  chartMode = mode;
  document.getElementById('toggleWeek').className = 'chart-toggle' + (mode==='week'?' active':'');
  document.getElementById('toggleMonth').className = 'chart-toggle' + (mode==='month'?' active':'');

  try {
    var r = await fetch('/api/admin/daily-activity');
    var d = await r.json();
    chartData = d.daily || [];
    renderChart();
  } catch(e) { document.getElementById('chartArea').innerHTML = '<div class="loading">Failed to load</div>'; }
}

function renderChart() {
  var area = document.getElementById('chartArea');
  var startDate, endDate;

  if (chartMode === 'custom') {
    startDate = document.getElementById('chartStart').value;
    endDate = document.getElementById('chartEnd').value;
    if (!startDate && !endDate) { loadChart('week'); return; }
    if (!startDate) startDate = '2020-01-01';
    if (!endDate) endDate = new Date().toISOString().slice(0,10);
  } else {
    var days = chartMode === 'week' ? 7 : 30;
    var cutoff = new Date();
    cutoff.setDate(cutoff.getDate() - days);
    startDate = cutoff.toISOString().slice(0,10);
    endDate = new Date().toISOString().slice(0,10);
  }

  // Build data map
  var dataMap = {};
  chartData.forEach(function(d){ dataMap[d.day] = d.count; });

  // Build bars for each day in range
  var bars = [];
  var s = new Date(startDate + 'T00:00:00');
  var e = new Date(endDate + 'T00:00:00');
  var d = new Date(s);
  while (d <= e) {
    var key = d.toISOString().slice(0,10);
    bars.push({day: key, label: chartDays[d.getDay()]+' '+d.getDate(), count: dataMap[key] || 0});
    d.setDate(d.getDate() + 1);
  }

  // If custom range has lots of days, skip labels to avoid clutter
  var labelEvery = bars.length <= 14 ? 1 : Math.ceil(bars.length / 14);

  var maxCount = Math.max.apply(null, bars.map(function(b){return b.count;}));
  if (maxCount === 0) maxCount = 1;
  var chartH = 170;
  var barW = Math.max(Math.floor((area.clientWidth - 48) / bars.length), 4);

  area.innerHTML = bars.length > 60 ? '<div style="padding:20px;color:var(--gray-400);text-align:center">Too many days — narrow your range (max 60 days)</div>' : '';
  if (bars.length > 60) return;

  area.innerHTML = '';
  bars.forEach(function(b, i){
    var h = Math.max((b.count / maxCount) * chartH, 1);
    var left = 40 + i * barW;
    var top = chartH - h;
    var showLabel = (i % labelEvery === 0) || (i === bars.length - 1);
    area.innerHTML +=
      '<div class="chart-bar" style="left:'+left+'px;top:'+top+'px;width:'+(barW-2)+'px;height:'+h+'px">'+
      '<div class="chart-bar-value" style="top:-18px">'+(b.count>0?b.count:'')+'</div>'+
      '</div>'+
      '<div class="chart-bar-label" style="left:'+left+'px;bottom:4px;width:'+barW+'px">'+
      (showLabel ? (chartMode==='week'||bars.length<=14 ? b.label : b.label.slice(-2)) : '')+
      '</div>';
  });
}

// ── User management ──
async function loadUsers() {
  var tbody = document.getElementById('usersList');
  try {
    var r = await fetch('/api/admin/users', authHeaders());
    if (!r.ok) {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--red);padding:16px">❌ Failed to load users (HTTP '+r.status+') — refresh and try again</td></tr>';
      return;
    }
    var d = await r.json();
    if (d.users && d.users.length > 0) {
      tbody.innerHTML = d.users.map(function(u){
        var isSelf = currentUser && u.id === currentUser.id;
        var delTitle = isSelf ? 'Cannot delete yourself' : 'Delete this user';
        var delDisabled = isSelf ? ' disabled' : '';
        var delBtn = '<button class="btn-sm danger"'+delDisabled+' onclick="deleteUser('+u.id+')" title="'+delTitle+'">🗑</button>';
        var resetBtn = '<button class="btn-sm" onclick="resetPassword('+u.id+',\''+esc(u.username)+'\')" style="margin-left:3px">🔑</button>';
        var lastLogin = u.last_login ? u.last_login.replace('T',' ').slice(0,16) : 'Never';
        var statusBadge = u.status === 'pending'
          ? '<span style="font-size:0.75em;padding:2px 8px;border-radius:4px;background:#fef3c7;color:#92400e">⏳ Pending</span>'
          : '<span style="font-size:0.75em;padding:2px 8px;border-radius:4px;background:#dcfce7;color:#166534">✅ Active</span>';
        var activateBtn = u.status === 'pending'
          ? '<button class="btn-sm" onclick="activateUser('+u.id+')" style="margin-left:3px;background:#16a34a;color:white">✅ Activate</button>'
          : '';
        return '<tr><td><strong>'+esc(u.username)+'</strong></td><td><span style="font-size:0.75em;padding:2px 6px;border-radius:4px;background:'+(u.role==='admin'?'#fee2e2;color:#991b1b':'var(--gray-100);color:var(--gray-700)')+'">'+esc(u.role)+'</span></td><td>'+esc(u.display_name||'')+'</td><td>'+statusBadge+'</td><td>'+esc(u.created_at||'')+'</td><td style="font-size:0.8em;color:var(--gray-500)">'+esc(lastLogin)+'</td><td>'+activateBtn+delBtn+resetBtn+'</td></tr>';
      }).join('');
    } else {
      tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--gray-400);padding:16px">No users found</td></tr>';
    }
  } catch(e) {
    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--red);padding:16px">❌ Error loading users: '+esc(String(e))+'</td></tr>';
  }
}

async function createUser() {
  var u = document.getElementById('newUsername').value.trim();
  var p = document.getElementById('newPassword').value;
  var n = document.getElementById('newDisplayName').value.trim();
  var r = document.getElementById('newRole').value;
  var err = document.getElementById('userError');
  err.style.display = 'none';
  if (!u || !p) { err.textContent = 'Username and password required'; err.style.display = 'inline'; return; }
  try {
    var resp = await fetch('/api/admin/users', {
      method:'POST',
      headers:{'Content-Type':'application/json', 'Authorization':'Bearer '+token},
      body:JSON.stringify({username:u, password:p, role:r, display_name:n})
    });
    var d = await resp.json();
    if (d.success) {
      document.getElementById('newUsername').value = '';
      document.getElementById('newPassword').value = '';
      document.getElementById('newDisplayName').value = '';
      loadUsers();
    } else {
      err.textContent = '❌ ' + (d.error || 'Failed');
      err.style.display = 'inline';
    }
  } catch(e) { err.textContent = '❌ Network error'; err.style.display = 'inline'; }
}

async function deleteUser(uid) {
  if (!confirm('Delete this user? This cannot be undone. Their activity stats will remain on the dashboard.')) return;
  try {
    var r = await fetch('/api/admin/users/'+uid, {method:'DELETE', headers:{'Authorization':'Bearer '+token}});
    var d = await r.json();
    if (d.success) {
      loadUsers();
      loadTeamDashboard();
    } else {
      alert('❌ ' + (d.error || 'Failed to delete'));
    }
  } catch(e) { alert('❌ Network error'); }
}

async function activateUser(uid) {
  if (!confirm('Activate this user? They will be able to sign in immediately.')) return;
  try {
    var r = await fetch('/api/admin/users/'+uid+'/activate', {method:'PATCH', headers:{'Authorization':'Bearer '+token}});
    var d = await r.json();
    if (d.success) {
      loadUsers();
    } else {
      alert('❌ ' + (d.error || 'Failed to activate'));
    }
  } catch(e) { alert('❌ Network error'); }
}

// ── Agents management ──
async function loadAgents() {
  var tbody = document.getElementById('agentsList');
  try {
    var r = await fetch('/api/admin/agents', authHeaders());
    var d = await r.json();
    if (d.agents && d.agents.length > 0) {
      tbody.innerHTML = d.agents.map(function(a) {
        return '<tr><td>'+esc(a.name)+'</td><td>'+esc(a.phone||'—')+'</td><td>'+esc(a.email||'—')+'</td><td>'+esc(a.agent_code||'—')+'</td><td>'+esc(a.created_at||'—')+'</td>'+
               '<td><button class="btn-sm danger" onclick="deleteAgent('+a.id+')">🗑 Delete</button></td></tr>';
      }).join('');
    } else {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--gray-400);padding:20px">No agents yet</td></tr>';
    }
  } catch(e) { tbody.innerHTML = '<tr><td colspan="6" class="error">Failed to load</td></tr>'; }
}

async function createAgent() {
  var name = document.getElementById('newAgentName').value.trim();
  var phone = document.getElementById('newAgentPhone').value.trim();
  var email = document.getElementById('newAgentEmail').value.trim();
  var code = document.getElementById('newAgentCode').value.trim();
  var err = document.getElementById('agentError');
  err.style.display = 'none';
  if (!name) { err.textContent = '❌ Name is required'; err.style.display = 'inline'; return; }
  try {
    var r = await fetch('/api/admin/agents', {
      method: 'POST',
      headers: {'Content-Type': 'application/json', 'Authorization': 'Bearer '+token},
      body: JSON.stringify({name: name, phone: phone, email: email, agent_code: code})
    });
    var d = await r.json();
    if (d.success) {
      document.getElementById('newAgentName').value = '';
      document.getElementById('newAgentPhone').value = '';
      document.getElementById('newAgentEmail').value = '';
      document.getElementById('newAgentCode').value = '';
      loadAgents();
    } else {
      err.textContent = '❌ ' + (d.error || 'Failed');
      err.style.display = 'inline';
    }
  } catch(e) { err.textContent = '❌ Network error'; err.style.display = 'inline'; }
}

async function deleteAgent(aid) {
  if (!confirm('Delete this agent?')) return;
  try {
    var r = await fetch('/api/admin/agents/'+aid, {method:'DELETE', headers:{'Authorization':'Bearer '+token}});
    var d = await r.json();
    if (d.success) { loadAgents(); }
    else { alert('❌ ' + (d.error || 'Failed')); }
  } catch(e) { alert('❌ Network error'); }
}

// ── Admin supporter search ──
var _lastAdminResults = [];

async function adminSearch() {
  // Clear name sub-filter
  document.getElementById('adminNameFilter').value = '';
  document.getElementById('adminNameFilterRow').style.display = 'none';
  _lastAdminResults = [];

  var q = document.getElementById('adminSearchInput').value.trim();
  var supportFilter = document.getElementById('adminSupportFilter').value;
  var signFilter = document.getElementById('adminSignFilter').value;
  var pollFilter = document.getElementById('adminPollFilter').value;
  if (q.length < 2 && !supportFilter && !signFilter && !pollFilter) return;
  var tbody = document.getElementById('adminSearchResults');
  tbody.innerHTML = '<tr><td colspan="10" class="loading">Searching...</td></tr>';
  try {
    var url = '/api/search?q='+encodeURIComponent(q)+'&limit=50';
    if (supportFilter) url += '&support_level='+encodeURIComponent(supportFilter);
    if (signFilter) url += '&sign_request='+encodeURIComponent(signFilter);
    if (pollFilter) url += '&poll='+encodeURIComponent(pollFilter);
    var r = await fetch(url);
    var d = await r.json();
    _lastAdminResults = d.results || [];
    if (d.results && d.results.length > 0) {
      // Show name sub-filter
      var nfRow = document.getElementById('adminNameFilterRow');
      nfRow.style.display = 'block';
      document.getElementById('adminNameFilter').focus();
      tbody.innerHTML = d.results.map(function(s){
        var addr = [s.street_number, s.street].filter(Boolean).join(' ');
        var badge = getSupportBadgeLabel(s.support_level);
        var rowId = 'arow-'+s.id;
        return '<tr id="'+rowId+'">'+
          '<td id="ar-'+s.id+'-name"><strong style="cursor:pointer" onclick="adminOpenRecord('+s.id+')" title="Click to open full record view">'+esc(s.full_name||'—')+'</strong></td>'+
          '<td id="ar-'+s.id+'-addr">'+esc(addr)+(s.apartment?', Apt '+esc(s.apartment):'')+'</td>'+
          '<td id="ar-'+s.id+'-phone">'+esc(s.phone||'—')+'</td>'+
          '<td id="ar-'+s.id+'-email" style="font-size:0.85em;color:var(--gray-600)">'+esc(s.email||'—')+'</td>'+
          '<td id="ar-'+s.id+'-poll" style="font-weight:600"><a href="/poll_maps/normalized/poll_'+esc(s.poll)+'.png" target="_blank" style="text-decoration:none" title="View map" class="'+getPollBadgeClass(s.poll)+'" style="padding:1px 8px;border-radius:8px;font-size:0.85em">🗺 '+(s.poll||'—')+'</a></td>'+
          '<td id="ar-'+s.id+'-level">'+badge+'</td>'+
          '<td id="ar-'+s.id+'-sign">'+esc(s.sign_request||'—')+'</td>'+
          '<td id="ar-'+s.id+'-notes" style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:0.85em;color:var(--gray-600)">'+esc(s.notes||'—')+'</td>'+
          '<td id="ar-'+s.id+'-updated" style="font-size:0.75em;color:var(--gray-400)">'+esc(s.updated_at||'—')+'</td>'+
          '<td id="ar-'+s.id+'-actions" style="white-space:nowrap"><button class="btn-sm" onclick="adminEditRow('+s.id+')" title="Edit">✏️</button> <button class="btn-sm" onclick="adminToggleHistory('+s.id+')" title="View change history">📜</button><br><span id="ar-'+s.id+'-status" style="font-size:0.7em;color:var(--amber);margin-top:2px;display:inline-block"></span></td>'+
          '</tr>';
      }).join('');
      tbody.innerHTML += '<tr><td colspan="10" style="text-align:center;color:var(--gray-400);font-size:0.8em">'+d.total+' results · showing first '+d.results.length+'</td></tr>';
    } else {
      tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;color:var(--gray-400);padding:20px">No results</td></tr>';
    }
  } catch(e) {
    tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;color:var(--red);padding:16px">Search failed</td></tr>';
  }
}

// ── Quick Export functions ──
async function adminExportFilter(type) {
  var counts = window._exportCounts || {};
  var labelMap = { supporter: 'Supporters', neutral: 'Neutral', 'non-supporter': 'Non-Supporters', requested: 'Signs Requested', declined: 'Signs Declined' };
  var label = labelMap[type] || type;
  var cnt = counts[type] || 0;
  var cntStr = cnt > 0 ? cnt.toLocaleString() : '';

  var url = '/api/search/export?q=';
  if (type === 'supporter') url += '&support_level=Supporter';
  else if (type === 'neutral') url += '&support_level=Neutral';
  else if (type === 'non-supporter') url += '&support_level=Non-Supporter';
  else if (type === 'requested') url += '&sign_request=Requested';
  else if (type === 'declined') url += '&sign_request=Declined';

  // Flash the clicked button
  var btn = event.target;
  btn.classList.add('active-download');
  var origText = btn.textContent;
  btn.textContent = '⏳ Downloading ' + label + (cntStr ? ' (' + cntStr + ')' : '') + '...';

  // Toast notification
  showAdminToast('📥 Downloading ' + cntStr + ' ' + label + ' as CSV...');

  var a = document.createElement('a');
  a.href = url;
  var today = new Date().toISOString().slice(0,10);
  a.download = 'Ward25_' + type.replace(/\s+/g,'_') + '_' + today + '.csv';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);

  setTimeout(function() {
    btn.classList.remove('active-download');
    btn.textContent = origText;
    showAdminToast('✅ Downloaded ' + cntStr + ' ' + label + '!');
  }, 1000);
}

async function adminExportCurrent() {
  var q = document.getElementById('adminSearchInput').value.trim();
  var supportFilter = document.getElementById('adminSupportFilter').value;
  var signFilter = document.getElementById('adminSignFilter').value;
  var pollFilter = document.getElementById('adminPollFilter').value;
  var url = '/api/search/export?q=' + encodeURIComponent(q);
  var label = 'Current View';
  if (supportFilter) {
    url += '&support_level=' + encodeURIComponent(supportFilter);
    label = supportFilter + (label !== 'Current View' ? ' + ' + label : '');
  }
  if (signFilter) {
    url += '&sign_request=' + encodeURIComponent(signFilter);
    label = (label !== 'Current View' ? label + ' + ' : '') + signFilter;
  }
  if (pollFilter) {
    url += '&poll=' + encodeURIComponent(pollFilter);
    label = (label !== 'Current View' ? label + ' + ' : '') + 'Poll ' + pollFilter;
  }

  // Flash the clicked button
  var btn = event.target;
  btn.classList.add('active-download');
  var origText = btn.textContent;
  btn.textContent = '⏳ Downloading ' + label + '...';
  showAdminToast('📥 Downloading ' + label + ' as CSV...');

  var a = document.createElement('a');
  a.href = url;
  var today = new Date().toISOString().slice(0,10);
  var nameParts = [];
  if (pollFilter) nameParts.push('Poll' + pollFilter);
  else nameParts.push('AllPolls');
  if (supportFilter) nameParts.push(supportFilter.replace(/\s+/g,''));
  else nameParts.push('AllSupport');
  if (signFilter) nameParts.push(signFilter);
  else nameParts.push('AllSign');
  if (q) nameParts.push(q.replace(/[^a-zA-Z0-9]/g,'_').substring(0,20));
  a.download = 'Ward25_' + nameParts.join('_') + '_' + today + '.csv';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);

  setTimeout(function() {
    btn.classList.remove('active-download');
    btn.textContent = origText;
    showAdminToast('✅ Downloaded ' + label + '!');
  }, 1000);
}

var adminEditCache = {};
var _adminEditingId = null;

function adminEditRow(id) {
  // Collapse any other open edit first
  if (_adminEditingId && _adminEditingId !== id) adminCancelRow(_adminEditingId);
  _adminEditingId = id;

  var cache = {};
  ['name','addr','phone','level','sign','notes','email','poll'].forEach(function(f){
    var el = document.getElementById('ar-'+id+'-'+f);
    if (el) cache[f] = el.innerHTML;
  });
  adminEditCache[id] = cache;

  // Show editing status
  var statusEl = document.getElementById('ar-'+id+'-status');
  if (statusEl) statusEl.textContent = '✏️ Editing...';

  // Fetch current data from the server for accurate values
  fetch('/api/supporter/'+id).then(function(r){return r.json()}).then(function(d){
    if (!d.supporter) return;
    var s = d.supporter;
    document.getElementById('ar-'+id+'-name').innerHTML = '<input type="text" id="ein-'+id+'-name" value="'+esc(s.full_name||'')+'" style="width:100%;padding:4px;border:1px solid var(--gray-200);border-radius:4px;font-size:0.85em">';
    var addr = [s.street_number, s.street].filter(Boolean).join(' ');
    document.getElementById('ar-'+id+'-addr').innerHTML = '<input type="text" id="ein-'+id+'-addr" value="'+esc(addr)+'" style="width:100%;padding:4px;border:1px solid var(--gray-200);border-radius:4px;font-size:0.85em"><input type="text" id="ein-'+id+'-apt" value="'+esc(s.apartment||'')+'" placeholder="Apt" style="width:60px;padding:4px;border:1px solid var(--gray-200);border-radius:4px;font-size:0.85em;margin-left:4px">';
    document.getElementById('ar-'+id+'-phone').innerHTML = '<input type="text" id="ein-'+id+'-phone" value="'+esc(s.phone||'')+'" style="width:100%;padding:4px;border:1px solid var(--gray-200);border-radius:4px;font-size:0.85em">';
    // Email field
    var emailEl = document.getElementById('ar-'+id+'-email');
    if (emailEl) emailEl.innerHTML = '<input type="email" id="ein-'+id+'-email" value="'+esc(s.email||'')+'" style="width:100%;padding:4px;border:1px solid var(--gray-200);border-radius:4px;font-size:0.85em">';
    document.getElementById('ar-'+id+'-level').innerHTML = '<select id="ein-'+id+'-level" style="padding:4px;border:1px solid var(--gray-200);border-radius:4px;font-size:0.85em"><option value="">—</option><option value="Supporter"'+(s.support_level==='Supporter'?' selected':'')+'>Supporter</option><option value="Neutral"'+(s.support_level==='Neutral'?' selected':'')+'>Neutral</option><option value="Non-Supporter"'+(s.support_level==='Non-Supporter'?' selected':'')+'>Non-Supporter</option><option value="Unknown"'+(s.support_level==='Unknown'?' selected':'')+'>Unknown</option><option value="Survey Refused"'+(s.support_level==='Survey Refused'?' selected':'')+'>Survey Refused</option></select>';
    document.getElementById('ar-'+id+'-sign').innerHTML = '<select id="ein-'+id+'-sign" style="padding:4px;border:1px solid var(--gray-200);border-radius:4px;font-size:0.85em"><option value="">—</option><option value="Requested"'+(s.sign_request==='Requested'?' selected':'')+'>Requested</option><option value="Declined"'+(s.sign_request==='Declined'?' selected':'')+'>Declined</option></select>';
    document.getElementById('ar-'+id+'-notes').innerHTML = '<textarea id="ein-'+id+'-notes" rows="2" style="width:100%;padding:4px;border:1px solid var(--gray-200);border-radius:4px;font-size:0.85em;resize:vertical;font-family:inherit">'+esc(s.notes||'')+'</textarea>';
    document.getElementById('ar-'+id+'-actions').innerHTML = '<button class="btn-sm" onclick="adminSaveRow('+id+')" style="background:#dcfce7;color:#166534;border-color:#bbf7d0">💾</button> <button class="btn-sm danger" onclick="adminCancelRow('+id+')">✕</button>';
  });
}

async function adminSaveRow(id) {
  var fullName = document.getElementById('ein-'+id+'-name').value.trim();
  var addr = document.getElementById('ein-'+id+'-addr').value.trim();
  var apt = document.getElementById('ein-'+id+'-apt') ? document.getElementById('ein-'+id+'-apt').value.trim() : '';
  var phone = document.getElementById('ein-'+id+'-phone').value.trim();
  var email = document.getElementById('ein-'+id+'-email') ? document.getElementById('ein-'+id+'-email').value.trim() : '';
  var level = document.getElementById('ein-'+id+'-level').value;
  var sign = document.getElementById('ein-'+id+'-sign').value;
  var notes = document.getElementById('ein-'+id+'-notes') ? document.getElementById('ein-'+id+'-notes').value.trim() : '';

  // Parse address into street_number and street
  var streetNum = '', street = '';
  var m = addr.match(/^(\d+[A-Za-z]?)\s+(.+)/);
  if (m) { streetNum = m[1]; street = m[2]; } else { street = addr; }

  var updates = {};
  if (fullName) updates.full_name = fullName;
  updates.street_number = streetNum;
  updates.street = street;
  if (apt) updates.apartment = apt;
  updates.phone = phone;
  updates.email = email;
  updates.support_level = level;
  updates.sign_request = sign;
  updates.notes = notes;

  try {
    var r = await fetch('/api/supporter/'+id, {
      method:'PUT',
      headers:{'Content-Type':'application/json','Authorization':token?'Bearer '+token:''},
      body:JSON.stringify(updates)
    });
    var d = await r.json();
    if (d.success) {
      // Refresh the row display
      var s = d.supporter;
      var addr2 = [s.street_number, s.street].filter(Boolean).join(' ');
      var badge = getSupportBadgeLabel(s.support_level);
      document.getElementById('ar-'+id+'-name').innerHTML = '<strong style="cursor:pointer" onclick="adminOpenRecord('+id+')" title="Click to open full record view">'+esc(s.full_name||'—')+'</strong>';
      document.getElementById('ar-'+id+'-addr').innerHTML = esc(addr2)+(s.apartment?', Apt '+esc(s.apartment):'');
      document.getElementById('ar-'+id+'-phone').innerHTML = esc(s.phone||'—');
      var emailEl = document.getElementById('ar-'+id+'-email');
      if (emailEl) emailEl.innerHTML = esc(s.email||'—');
      document.getElementById('ar-'+id+'-level').innerHTML = badge;
      document.getElementById('ar-'+id+'-sign').innerHTML = esc(s.sign_request||'—');
      document.getElementById('ar-'+id+'-notes').innerHTML = esc(s.notes||'—');
      document.getElementById('ar-'+id+'-updated').innerHTML = esc(s.updated_at||'—');
      document.getElementById('ar-'+id+'-actions').innerHTML = '<button class="btn-sm" onclick="adminEditRow('+id+')" title="Edit">✏️</button> <button class="btn-sm" onclick="adminToggleHistory('+id+')" title="View change history">📜</button>';
      var statusEl = document.getElementById('ar-'+id+'-status');
      if (statusEl) statusEl.textContent = '✅ Saved';
      _adminEditingId = null;
      delete adminEditCache[id];
      // Flash green
      document.getElementById('arow-'+id).style.background = '#dcfce7';
      setTimeout(function(){ document.getElementById('arow-'+id).style.background = ''; }, 1000);
    } else {
      alert('❌ Save failed: '+(d.error||'unknown'));
    }
  } catch(e) { alert('❌ Network error'); }
}

function adminCancelRow(id) {
  _adminEditingId = null;
  var cache = adminEditCache[id] || {};
  document.getElementById('ar-'+id+'-name').innerHTML = cache.name || '—';
  document.getElementById('ar-'+id+'-addr').innerHTML = cache.addr || '—';
  document.getElementById('ar-'+id+'-phone').innerHTML = cache.phone || '—';
  var emailEl = document.getElementById('ar-'+id+'-email');
  if (emailEl && cache.email !== undefined) emailEl.innerHTML = cache.email;
  document.getElementById('ar-'+id+'-level').innerHTML = cache.level || '—';
  document.getElementById('ar-'+id+'-sign').innerHTML = cache.sign || '—';
  document.getElementById('ar-'+id+'-notes').innerHTML = cache.notes || '—';
  document.getElementById('ar-'+id+'-actions').innerHTML = '<button class="btn-sm" onclick="adminEditRow('+id+')" title="Edit">✏️</button> <button class="btn-sm" onclick="adminToggleHistory('+id+')" title="View change history">📜</button>';
  var statusEl = document.getElementById('ar-'+id+'-status');
  if (statusEl) statusEl.textContent = '❌ Cancelled';
  setTimeout(function(){ if(statusEl) statusEl.textContent = ''; }, 2000);
  delete adminEditCache[id];
}
function formatDateTime(d) {
  if(!d) return '—';
  try {
    var iso = String(d).trim();
    if (iso.indexOf(' ') > -1 && iso.indexOf('T') === -1) iso = iso.replace(' ','T');
    if (iso.indexOf('T') === -1) iso += 'T00:00:00';
    return new Date(iso).toLocaleString('en-CA',{year:'numeric',month:'short',day:'numeric',hour:'numeric',minute:'2-digit'});
  } catch(e) { return String(d); }
}
var _adminHistoryOpen = null;
async function adminToggleHistory(id) {
  // Close any other open history first
  var existingRow = document.getElementById('ahistory-'+_adminHistoryOpen);
  if (existingRow) {
    existingRow.remove();
    if (_adminHistoryOpen === id) { _adminHistoryOpen = null; return; }
  }
  _adminHistoryOpen = id;

  var tbody = document.getElementById('adminSearchResults');
  var row = document.getElementById('arow-'+id);
  if (!row) return;

  // Insert a history row below the current row
  var tr = document.createElement('tr');
  tr.id = 'ahistory-'+id;
  tr.innerHTML = '<td colspan="10" style="padding:12px 16px;background:#fffbeb;border:1px solid #fde68a;border-radius:4px"><div style="font-size:0.82em;color:var(--gray-400)">Loading history...</div></td>';
  row.parentNode.insertBefore(tr, row.nextSibling);

  try {
    var r = await fetch('/api/supporter/'+id+'/history');
    var d = await r.json();
    if (!d.history || d.history.length === 0) {
      tr.innerHTML = '<td colspan="10" style="padding:12px 16px;background:#fffbeb;border:1px solid #fde68a"><div style="font-size:0.82em;color:var(--gray-400)">No changes yet.</div></td>';
      return;
    }
    var html = '<td colspan="10" style="padding:12px 16px;background:#fffbeb;border:1px solid #fde68a">';
    html += '<div style="font-weight:700;font-size:0.85em;margin-bottom:6px;color:var(--amber)">📜 Change History</div>';
    d.history.forEach(function(h) {
      html += '<div style="font-size:0.78em;padding:4px 0;border-bottom:1px solid #fde68a">'+
        '<span style="font-weight:600;color:var(--gray-700)">'+esc(h.field_name)+'</span>: '+
        '<span style="color:#991b1b;text-decoration:line-through">'+esc(h.old_value||'(empty)')+'</span> → '+
        '<span style="color:#166534">'+esc(h.new_value||'(empty)')+'</span>'+
        '<span style="color:var(--gray-400);margin-left:8px;font-size:0.9em">'+formatDateTime(h.changed_at)+' by '+esc(h.changed_by||'unknown')+'</span></div>';
    });
    html += '</td>';
    tr.innerHTML = html;
  } catch(e) {
    tr.innerHTML = '<td colspan="10" style="padding:12px 16px;background:#fffbeb;border:1px solid #fde68a"><div style="font-size:0.82em;color:var(--red)">Failed to load history</div></td>';
  }
}
function getSupportBadgeLabel(l) {
  l = (l||'').toLowerCase();
  if (l==='supporter') return '<span style="background:#dcfce7;color:#166534;padding:2px 8px;border-radius:4px;font-size:0.8em;font-weight:600">✓ Supporter</span>';
  if (l==='neutral') return '<span style="background:#f3f4f6;color:#374151;padding:2px 8px;border-radius:4px;font-size:0.8em">Neutral</span>';
  if (l==='non-supporter'||l==='non supporter') return '<span style="background:#fee2e2;color:#991b1b;padding:2px 8px;border-radius:4px;font-size:0.8em">✗ Non-Supporter</span>';
  return '<span style="color:var(--gray-400);font-size:0.8em">'+esc(l||'Unknown')+'</span>';
}

// ── Helpers for detail card ──
function adminBadge(l) {
  l=(l||'').toLowerCase();
  if(l==='supporter') return {label:'✓ Supporter',cls:'badge-supporter'};
  if(l==='neutral') return {label:'Neutral',cls:'badge-neutral'};
  if(l==='non-supporter'||l==='non supporter') return {label:'✗ Non-Supporter',cls:'badge-nonsupporter'};
  if(l==='survey refused') return {label:'🚫 Refused',cls:'badge-refused'};
  return {label:l||'Unknown',cls:'badge-unknown'};
}
function adminFmtDate(d) {
  if(!d) return '—';
  try {
    var iso = String(d).trim();
    if (iso.indexOf(' ') > -1 && iso.indexOf('T') === -1) iso = iso.replace(' ','T');
    if (iso.indexOf('T') === -1) iso += 'T00:00:00';
    return new Date(iso).toLocaleDateString('en-CA',{year:'numeric',month:'short',day:'numeric'});
  } catch(e) { return String(d); }
}
var _adminDetailId = null;
var _adminDetailOrig = {};
var _adminDetailNav = [];       // same-address record IDs
var _adminDetailNavIdx = -1;    // current position
var _adminDetailInfo = null;    // full record for add-resident

// ── Open a full canvass-style record card in admin ──
async function adminOpenRecord(id) {
  var pane = document.getElementById('adminRecordDetail');
  pane.innerHTML = '<div class="loading" style="padding:30px">Loading record...</div>';
  pane.style.display = 'block';
  pane.scrollIntoView({behavior:'smooth',block:'center'});
  _adminDetailId = id;
  try {
    var r = await fetch('/api/supporter/'+id);
    var d = await r.json();
    if (!d.supporter) { pane.innerHTML = '<div class="error">Record not found</div>'; return; }
    var s = d.supporter;
    _adminDetailInfo = s;   // store full record for add-resident
    var addr = [s.street_number, s.street].filter(Boolean).join(' ');
    var cityPc = [s.city, s.postal_code].filter(Boolean).join(' ');
    var badge = adminBadge(s.support_level);
    var pollHtml = s.poll ? '<span class="'+getPollBadgeClass(s.poll)+'" style="color:white;padding:1px 8px;border-radius:8px;font-size:0.75em;font-weight:700;white-space:nowrap">🗺 <a href="/poll_maps/normalized/poll_'+esc(s.poll)+'.png" target="_blank" style="color:white;text-decoration:none">Poll '+esc(s.poll)+'</a></span>' : '';

    // Build navigation list: query API for all records at same address
    _adminDetailNav = [id];  // start with current record
    _adminDetailNavIdx = 0;
    try {
      var hh = await fetch('/api/supporter/'+id+'/household');
      var hd = await hh.json();
      if (hd.members && hd.members.length) {
        hd.members.forEach(function(m) { _adminDetailNav.push(m.id); });
      }
    } catch(e) {}
    // Also merge any from current search results that the API might miss
    if (_lastAdminResults && _lastAdminResults.length) {
      var addrKey = (s.street_number||'')+'|'+(s.street||'');
      _lastAdminResults.forEach(function(r) {
        if ((r.street_number||'')+'|'+(r.street||'') === addrKey && _adminDetailNav.indexOf(r.id) === -1) {
          _adminDetailNav.push(r.id);
        }
      });
    }
    var navHtml = '';
    if (_adminDetailNav.length > 1) {
      var navItems = '';
      for (var ni = 0; ni < _adminDetailNav.length; ni++) {
        var nid = _adminDetailNav[ni];
        var isCurr = ni === _adminDetailNavIdx;
        navItems += '<button class="btn-sm" onclick="adminOpenRecord('+nid+')" style="'+(isCurr?'background:var(--red);color:white;font-weight:700':'background:var(--gray-100)')+';margin:0 2px;min-width:28px">'+(ni+1)+'</button>';
      }
      navHtml = '<div style="text-align:center;padding:4px 0 8px;font-size:0.82em;color:var(--gray-500)">'+
        '<button class="btn-sm" onclick="adminNavRecord(-1)" '+( _adminDetailNavIdx <= 0 ? 'disabled style="opacity:0.3"':'')+'>◀</button> '+
        navItems+
        ' <button class="btn-sm" onclick="adminNavRecord(1)" '+( _adminDetailNavIdx >= _adminDetailNav.length-1 ? 'disabled style="opacity:0.3"':'')+'>▶</button>'+
        '<br><span style="font-size:0.7em">'+_adminDetailNav.length+' residents at this address</span></div>';
    }

    var cardId = 'adetail-'+id;
    pane.innerHTML =
      '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">'+
        '<button class="detail-close" onclick="adminCloseRecord()">✕ Close</button>'+
        navHtml+
      '</div>'+
      '<div class="detail-card" id="'+cardId+'">'+
        '<div class="card-header"><div>'+
          '<div class="name" id="afv-'+id+'-full_name">'+esc(s.full_name||'Unknown')+'</div>'+
          '<div class="address-line">📍 '+esc(addr)+(s.apartment?', Apt '+esc(s.apartment):'')+(cityPc?' · '+esc(cityPc):'')+'</div>'+
          (pollHtml?pollHtml+' ':'')+
          (s.is_original?' <span style="background:#dcfce7;color:#166534;font-size:0.7em;padding:1px 6px;border-radius:4px;font-weight:600">✓ Original</span>':'')+
        '</div><span class="support-badge '+badge.cls+'">'+badge.label+'</span></div>'+
        '<div class="card-fields">'+
          adminFld('👤','First',s.first_name,id,'first_name')+
          adminFld('👥','Last',s.last_name,id,'last_name')+
          adminFld('📞','Phone',s.phone,id,'phone')+
          adminFld('✉️','Email',s.email,id,'email')+
          adminFld('🏠','Apt',s.apartment,id,'apartment')+
          adminFld('📋','Support',s.support_level,id,'support_level')+
          adminFld('🪧','Sign',s.sign_request,id,'sign_request')+
          adminFld('💬','Conv',s.candidate_conversation_request,id,'candidate_conversation_request')+
          adminFld('📝','Notes',s.notes,id,'notes')+
          adminFld('🕐','Updated',adminFmtDate(s.updated_at),id,'updated_at')+
        '</div>'+
        '<div class="card-actions">'+
          '<button class="btn-sm" onclick="adminDetailEdit('+id+')" style="background:var(--gray-100);color:var(--gray-700);font-size:0.85em">✏️ Edit All</button>'+
          '<button class="btn-sm" onclick="adminDetailSave('+id+')" style="background:#dcfce7;color:#166534;border-color:#bbf7d0;font-size:0.85em">💾 Save</button>'+
          '<button class="btn-sm" onclick="adminDetailHistory('+id+')" style="background:#fffbeb;color:#92400e;border-color:#fde68a;font-size:0.85em">📜 History</button>'+
          '<button class="btn-sm" onclick="adminShowTaskForm('+id+')" style="background:#e0f2fe;color:#0369a1;border-color:#7dd3fc;font-size:0.85em">📋 Task</button>'+
          '<button class="btn-sm" onclick="adminShowAddResident('+id+')" style="background:#dcfce7;color:#166534;border-color:#bbf7d0;font-size:0.85em">➕ Add Resident</button>'+
          '<span style="font-size:0.7em;color:var(--gray-400);margin-left:auto">ID:'+id+'</span>'+
        '</div>'+
        '<div id="ataskform-'+id+'" style="display:none;margin-top:8px;padding:10px;background:#f0f9ff;border:1px solid #bae6fd;border-radius:8px">'+
          '<div style="font-weight:600;font-size:0.85em;margin-bottom:6px;color:#0369a1">📋 Set Task & Reminder</div>'+
          '<input type="text" id="atask-desc-'+id+'" placeholder="What needs to be done?" style="width:100%;padding:6px 10px;border:1px solid #bae6fd;border-radius:6px;font-size:0.85em;font-family:inherit;margin-bottom:6px;box-sizing:border-box">'+
          '<div style="display:flex;gap:8px;align-items:center">'+
            '<input type="date" id="atask-due-'+id+'" style="flex:1;padding:6px 10px;border:1px solid #bae6fd;border-radius:6px;font-size:0.85em;font-family:inherit">'+
            '<button class="btn-sm" onclick="adminSetTask('+id+')" style="background:#0284c7;color:white;border-color:#0284c7;font-size:0.85em">✅ Set Task</button>'+
            '<button class="btn-sm" onclick="document.getElementById(\'ataskform-'+id+'\').style.display=\'none\'" style="font-size:0.85em">✕</button>'+
          '</div>'+
          '<div id="ataskstatus-'+id+'" style="font-size:0.78em;margin-top:4px;color:var(--gray-500)"></div>'+
        '</div>'+
        '<div id="aresform-'+id+'" style="display:none;margin-top:8px;padding:10px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px">'+
          '<div style="font-weight:600;font-size:0.85em;margin-bottom:6px;color:#166534">➕ Add Resident at Same Address</div>'+
          '<input type="text" id="ares-first-'+id+'" placeholder="First Name" style="width:100%;padding:6px 10px;border:1px solid #bbf7d0;border-radius:6px;font-size:0.85em;font-family:inherit;margin-bottom:6px;box-sizing:border-box">'+
          '<input type="text" id="ares-last-'+id+'" placeholder="Last Name" style="width:100%;padding:6px 10px;border:1px solid #bbf7d0;border-radius:6px;font-size:0.85em;font-family:inherit;margin-bottom:6px;box-sizing:border-box">'+
          '<div style="display:flex;gap:8px;margin-bottom:6px">'+
            '<input type="text" id="ares-phone-'+id+'" placeholder="Phone" style="flex:1;padding:6px 10px;border:1px solid #bbf7d0;border-radius:6px;font-size:0.85em;font-family:inherit;box-sizing:border-box">'+
            '<input type="text" id="ares-email-'+id+'" placeholder="Email" style="flex:1;padding:6px 10px;border:1px solid #bbf7d0;border-radius:6px;font-size:0.85em;font-family:inherit;box-sizing:border-box">'+
          '</div>'+
          '<div style="display:flex;gap:8px;margin-bottom:6px">'+
            '<input type="text" id="ares-apt-'+id+'" placeholder="Apt/Unit (optional)" style="flex:1;padding:6px 10px;border:1px solid #bbf7d0;border-radius:6px;font-size:0.85em;font-family:inherit;box-sizing:border-box">'+
            '<select id="ares-support-'+id+'" style="flex:1;padding:6px 10px;border:1px solid #bbf7d0;border-radius:6px;font-size:0.85em;font-family:inherit;box-sizing:border-box"><option value="">Support Level</option><option>Supporter</option><option>Neutral</option><option>Non-Supporter</option><option>Unknown</option><option>Survey Refused</option></select>'+
          '</div>'+
          '<div style="display:flex;gap:8px;align-items:center">'+
            '<button class="btn-sm" onclick="adminAddResident('+id+')" style="background:#166534;color:white;border-color:#166534;font-size:0.85em">➕ Add</button>'+
            '<button class="btn-sm" onclick="document.getElementById(\'aresform-'+id+'\').style.display=\'none\'" style="font-size:0.85em">✕ Cancel</button>'+
          '</div>'+
          '<div id="aresstatus-'+id+'" style="font-size:0.78em;margin-top:4px;color:var(--gray-500)"></div>'+
        '</div>'+
        '<div class="change-log" id="ahist-'+id+'"></div>'+
        '<div class="card-actions" id="aedit-actions-'+id+'" style="display:none;margin:0;padding:8px 0 0;border:none">'+
          '<button class="btn-sm" onclick="adminDetailCancel('+id+')" style="background:var(--gray-100);color:var(--gray-700);font-size:0.85em">Cancel</button>'+
          '<span style="font-size:0.75em;color:var(--amber);margin-left:auto" id="aedit-status-'+id+'"></span>'+
        '</div>'+
      '</div>';
  } catch(e) {
    pane.innerHTML = '<div class="error">Failed to load record</div>';
  }
}
function adminFld(emoji,label,val,id,field) {
  return '<div class="field-row"><span class="field-label">'+emoji+' '+label+'</span>'+
    '<span class="field-value" id="afv-'+id+'-'+field+'">'+esc(val||'—')+'</span></div>';
}
function adminCloseRecord() {
  document.getElementById('adminRecordDetail').style.display = 'none';
  _adminDetailId = null;
  _adminDetailInfo = null;
}

// ── Navigate same-address records ──
function adminNavRecord(dir) {
  var newIdx = _adminDetailNavIdx + dir;
  if (newIdx < 0 || newIdx >= _adminDetailNav.length) return;
  var newId = _adminDetailNav[newIdx];
  if (newId) adminOpenRecord(newId);
}

// ── Task / Reminder ──
function adminShowTaskForm(id) {
  document.getElementById('ataskform-'+id).style.display = 'block';
  document.getElementById('ataskform-'+id).scrollIntoView({behavior:'smooth',block:'nearest'});
}
async function adminSetTask(id) {
  var task = document.getElementById('atask-desc-'+id).value.trim();
  if (!task) { showAdminToast('❌ Enter a task description'); return; }
  var due = document.getElementById('atask-due-'+id).value || '';
  var statusEl = document.getElementById('ataskstatus-'+id);
  statusEl.textContent = '⏳ Creating task & sending notification...';
  try {
    var r = await fetch('/api/supporter/'+id+'/task', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({task:task, due_date:due})
    });
    var d = await r.json();
    if (d.success) {
      statusEl.innerHTML = '✅ Task set' + (d.email_sent ? ' & emailed to info@electshawnallen.ca 📧' : '') + ' — <a href="#" onclick="adminCloseRecord();adminSearch();return false">Refresh results</a>';
      document.getElementById('atask-desc-'+id).value = '';
      document.getElementById('atask-due-'+id).value = '';
      showAdminToast('✅ Task created' + (d.email_sent ? ' + email sent' : ''));
    } else {
      statusEl.textContent = '❌ ' + (d.error || 'Failed');
    }
  } catch(e) {
    statusEl.textContent = '❌ Network error';
  }
}

// ── Add Resident at Same Address ──
function adminShowAddResident(id) {
  var form = document.getElementById('aresform-'+id);
  form.style.display = (form.style.display === 'none' || !form.style.display) ? 'block' : 'none';
  if (form.style.display === 'block') {
    form.scrollIntoView({behavior:'smooth',block:'nearest'});
    document.getElementById('ares-first-'+id).focus();
  }
}
async function adminAddResident(id) {
  var first = document.getElementById('ares-first-'+id).value.trim();
  var last = document.getElementById('ares-last-'+id).value.trim();
  var fullName = (first + ' ' + last).trim();
  if (!fullName) { showAdminToast('❌ Enter at least a first or last name'); return; }
  var statusEl = document.getElementById('aresstatus-'+id);
  statusEl.textContent = '⏳ Adding resident...';

  // Get address from stored record info
  var info = _adminDetailInfo || {};
  var body = {
    full_name: fullName,
    first_name: first,
    last_name: last,
    street_number: info.street_number || '',
    street: info.street || '',
    city: info.city || '',
    postal_code: info.postal_code || '',
    phone: document.getElementById('ares-phone-'+id).value.trim(),
    email: document.getElementById('ares-email-'+id).value.trim(),
    apartment: document.getElementById('ares-apt-'+id).value.trim() || info.apartment || '',
    support_level: document.getElementById('ares-support-'+id).value,
    poll: info.poll || '',
  };

  try {
    var r = await fetch('/api/supporter', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify(body)
    });
    var d = await r.json();
    if (d.success) {
      statusEl.innerHTML = '✅ Added <b>'+esc(fullName)+'</b> (ID:'+d.supporter.id+') — <a href=\"#\" onclick=\"adminCloseRecord();adminSearch();return false\">Refresh search</a>';
      // Clear form fields
      document.getElementById('ares-first-'+id).value = '';
      document.getElementById('ares-last-'+id).value = '';
      document.getElementById('ares-phone-'+id).value = '';
      document.getElementById('ares-email-'+id).value = '';
      document.getElementById('ares-apt-'+id).value = '';
      document.getElementById('ares-support-'+id).value = '';
      showAdminToast('✅ Added '+fullName);
    } else {
      statusEl.textContent = '❌ ' + (d.error || 'Failed');
    }
  } catch(e) {
    statusEl.textContent = '❌ Network error';
  }
}

// ── Detail card editing (canvass-style) ──
var _adminDetailEditing = false;
var _adminDetailInputs = ['full_name','first_name','last_name','phone','email','apartment','support_level','sign_request','candidate_conversation_request','notes'];
var _adminDetailSelects = {'support_level':['Supporter','Neutral','Non-Supporter','Unknown','Survey Refused'],'sign_request':['','Requested','Declined'],'candidate_conversation_request':['','Requested','Declined']};

async function adminDetailEdit(id) {
  if (_adminDetailEditing) return;
  _adminDetailEditing = true;
  _adminDetailOrig = {};
  document.getElementById('aedit-actions-'+id).style.display = 'flex';
  document.getElementById('aedit-status-'+id).textContent = '✏️ Editing...';
  _adminDetailInputs.forEach(function(field) {
    var el = document.getElementById('afv-'+id+'-'+field);
    if (!el) return;
    var val = el.textContent === '—' ? '' : el.textContent;
    _adminDetailOrig[field] = val;
    el.classList.add('editing');
    var opts = _adminDetailSelects[field];
    if (opts) {
      el.innerHTML = '<select id="ainput-'+id+'-'+field+'">'+opts.map(function(o){return '<option value="'+esc(o)+'"'+(o===val?' selected':'')+'>'+(o||'(none)')+'</option>';}).join('')+'</select>';
    } else if (field === 'notes') {
      el.innerHTML = '<textarea id="ainput-'+id+'-'+field+'" rows="2">'+esc(val)+'</textarea>';
    } else {
      el.innerHTML = '<input type="text" id="ainput-'+id+'-'+field+'" value="'+esc(val)+'">';
    }
  });
}
async function adminDetailSave(id) {
  var updates = {};
  _adminDetailInputs.forEach(function(field) {
    var el = document.getElementById('ainput-'+id+'-'+field);
    if (!el) return;
    if (field === 'full_name') {
      var name = el.value.trim();
      if (name) updates.full_name = name;
      var parts = name.split(' ');
      updates.first_name = parts[0] || '';
      updates.last_name = parts.slice(1).join(' ') || '';
    } else if (el.value !== _adminDetailOrig[field]) {
      updates[field] = el.value;
    }
  });
  if (Object.keys(updates).length > 0) {
    document.getElementById('aedit-status-'+id).textContent = 'Saving...';
    try {
      var r = await fetch('/api/supporter/'+id, {
        method:'PUT',
        headers:{'Content-Type':'application/json','Authorization':token?'Bearer '+token:''},
        body:JSON.stringify(updates)
      });
      var d = await r.json();
      if (d.success) {
        showAdminToast('✅ '+d.changes_count+' field(s) updated');
        adminCloseRecord();
        adminSearch();
      } else {
        showAdminToast('❌ Save failed');
      }
    } catch(e) { showAdminToast('❌ Network error'); }
  }
  _adminDetailEditing = false;
}
function adminDetailCancel(id) {
  _adminDetailEditing = false;
  document.getElementById('aedit-actions-'+id).style.display = 'none';
  document.getElementById('aedit-status-'+id).textContent = '';
  adminOpenRecord(id);
}
async function adminDetailHistory(id) {
  var el = document.getElementById('ahist-'+id);
  if (el.classList.contains('show')) { el.classList.remove('show'); el.innerHTML = ''; return; }
  el.innerHTML = '<div style="color:var(--gray-400);padding:8px;font-size:0.85em">Loading...</div>';
  el.classList.add('show');
  try {
    var r = await fetch('/api/supporter/'+id+'/history');
    var d = await r.json();
    if (!d.history || d.history.length === 0) { el.innerHTML = '<div style="color:var(--gray-400);padding:8px;font-size:0.82em">No changes yet.</div>'; return; }
    el.innerHTML = d.history.map(function(h) {
      return '<div class="log-entry" style="padding:4px 0;border-bottom:1px solid #fde68a;font-size:0.82em">'+
        '<span class="log-field" style="font-weight:600;color:var(--amber)">'+esc(h.field_name)+'</span>: '+
        '<span class="log-old" style="color:var(--red);text-decoration:line-through">'+esc(h.old_value||'(empty)')+'</span> → '+
        '<span class="log-new" style="color:var(--green)">'+esc(h.new_value||'(empty)')+'</span>'+
        '<div class="log-date" style="font-size:0.8em;color:var(--gray-400)">'+formatDateTime(h.changed_at)+' by '+esc(h.changed_by||'unknown')+'</div></div>';
    }).join('');
  } catch(e) { el.innerHTML = '<div style="color:var(--red);padding:8px;font-size:0.82em">Failed to load history</div>'; }
}

// ── Tasks Management ──
var _tasksStatus = 'open';
var _tasksLoaded = {};
async function adminToggleTasks() {
  var panel = document.getElementById('tasksPanel');
  panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
  if (panel.style.display === 'block' && !_tasksLoaded['open']) {
    await adminLoadTasks('open');
  }
}
async function adminLoadTasks(status) {
  _tasksStatus = status || 'open';
  // Update tabs
  ['open','completed','archived'].forEach(function(s){
    var tab = document.getElementById('taskTab'+s.charAt(0).toUpperCase()+s.slice(1));
    if (tab) tab.classList.toggle('active', s === _tasksStatus);
  });
  var tbody = document.getElementById('tasksBody');
  tbody.innerHTML = '<tr><td colspan="9" class="loading">Loading...</td></tr>';
  try {
    var r = await fetch('/api/admin/tasks?status='+encodeURIComponent(_tasksStatus));
    var d = await r.json();
    _tasksLoaded[_tasksStatus] = true;
    document.getElementById('tasksCount').textContent = '(' + d.count + ')';
    if (!d.tasks || d.tasks.length === 0) {
      tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;color:var(--gray-400);padding:20px">No ' + _tasksStatus + ' tasks</td></tr>';
      return;
    }
    tbody.innerHTML = d.tasks.map(function(t) {
      var dueClass = '';
      if (t.due_date) {
        var today = new Date().toISOString().slice(0,10);
        if (t.due_date < today && t.status === 'open') dueClass = ' style="color:var(--red);font-weight:600"';
      }
      var statusBadge = t.status === 'open' ? '<span style="color:var(--amber);font-weight:600">📋 Open</span>'
        : t.status === 'completed' ? '<span style="color:var(--green);font-weight:600">✅ Done</span>'
        : '<span style="color:var(--gray-400);font-weight:600">🗄️ Archived</span>';
      var completedStr = t.completed_at ? t.completed_at.replace('T',' ').slice(0,16) + (t.completed_by ? ' by '+esc(t.completed_by) : '') : '—';
      var archivedStr = t.archived_at ? t.archived_at.replace('T',' ').slice(0,16) : '—';
      var actions = '';
      if (t.status === 'open') {
        actions += '<button class="btn-sm" onclick="adminCompleteTask('+t.id+')" style="background:#dcfce7;color:#166534;border-color:#bbf7d0" title="Mark complete">✅</button> ';
        actions += '<button class="btn-sm" onclick="adminArchiveTask('+t.id+')" title="Archive">🗄️</button>';
      } else if (t.status === 'completed') {
        actions += '<button class="btn-sm" onclick="adminReopenTask('+t.id+')" title="Re-open">↩️</button> ';
        actions += '<button class="btn-sm" onclick="adminArchiveTask('+t.id+')" title="Archive">🗄️</button>';
      } else {
        actions += '<button class="btn-sm" onclick="adminReopenTask('+t.id+')" title="Re-open">↩️</button>';
      }
      return '<tr>'+
        '<td style="position:sticky;left:0;background:white;z-index:3;box-shadow:2px 0 4px rgba(0,0,0,0.05)"><strong><a href="#" onclick="adminOpenRecord('+t.supporter_id+');return false" style="text-decoration:none;color:var(--gray-900)">'+esc(t.full_name)+'</a></strong><br><span style="font-size:0.8em;color:var(--gray-400)">'+esc(t.address)+(t.apartment?', Apt '+esc(t.apartment):'')+'</span></td>'+
        '<td>'+esc(t.task_text)+'</td>'+
        '<td'+dueClass+'>'+(t.due_date||'—')+'</td>'+
        '<td style="font-size:0.8em;color:var(--gray-400)">'+esc(t.created_at)+'</td>'+
        '<td style="font-size:0.8em">'+esc(t.created_by||'—')+'</td>'+
        '<td>'+statusBadge+'</td>'+
        '<td style="font-size:0.8em;color:var(--gray-500)">'+completedStr+'</td>'+
        '<td style="font-size:0.8em;color:var(--gray-400)">'+archivedStr+'</td>'+
        '<td style="white-space:nowrap">'+actions+'</td>'+
        '</tr>';
    }).join('');
  } catch(e) {
    tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;color:var(--red);padding:16px">Failed to load tasks</td></tr>';
  }
}

async function adminCompleteTask(taskId) {
  try {
    var r = await fetch('/api/admin/tasks/complete', {
      method:'POST',
      headers:{'Content-Type':'application/json', 'Authorization':'Bearer '+token},
      body:JSON.stringify({task_id: taskId})
    });
    var d = await r.json();
    if (d.success) {
      showAdminToast('✅ Task completed by '+esc(d.completed_by));
      adminLoadTasks(_tasksStatus);
    } else {
      showAdminToast('❌ '+(d.error||'Failed'));
    }
  } catch(e) { showAdminToast('❌ Network error'); }
}

async function adminArchiveTask(taskId) {
  if (!confirm('Archive this task?')) return;
  try {
    var r = await fetch('/api/admin/tasks/archive', {
      method:'POST',
      headers:{'Content-Type':'application/json', 'Authorization':'Bearer '+token},
      body:JSON.stringify({task_id: taskId})
    });
    var d = await r.json();
    if (d.success) {
      showAdminToast('🗄️ Task archived');
      adminLoadTasks(_tasksStatus);
    } else {
      showAdminToast('❌ '+(d.error||'Failed'));
    }
  } catch(e) { showAdminToast('❌ Network error'); }
}

async function adminReopenTask(taskId) {
  try {
    var r = await fetch('/api/admin/tasks/reopen', {
      method:'POST',
      headers:{'Content-Type':'application/json', 'Authorization':'Bearer '+token},
      body:JSON.stringify({task_id: taskId})
    });
    var d = await r.json();
    if (d.success) {
      showAdminToast('↩️ Task re-opened');
      adminLoadTasks(_tasksStatus);
    } else {
      showAdminToast('❌ '+(d.error||'Failed'));
    }
  } catch(e) { showAdminToast('❌ Network error'); }
}

// ── Survey Responses ──
var _surveysLoaded = false;
async function adminToggleSurveys() {
  var panel = document.getElementById('surveysPanel');
  panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
  if (panel.style.display === 'block' && !_surveysLoaded) {
    _surveysLoaded = true;
    await adminLoadSurveys();
  }
}
async function adminLoadSurveys() {
  var tbody = document.getElementById('surveysBody');
  tbody.innerHTML = '<tr><td colspan="11" class="loading">Loading surveys...</td></tr>';
  try {
    var r = await fetch('/api/admin/surveys?limit=500');
    var d = await r.json();
    document.getElementById('surveysCount').textContent = '(' + d.total + ')';
    document.getElementById('surveysTotal').textContent = d.total + ' total surveys (showing ' + d.surveys.length + ')';
    if (!d.surveys || d.surveys.length === 0) {
      tbody.innerHTML = '<tr><td colspan="11" style="text-align:center;color:var(--gray-400);padding:20px">No surveys yet</td></tr>';
      return;
    }
    tbody.innerHTML = d.surveys.map(function(s) {
      var topIssue = esc(s.top_issue || '');
      if (s.top_issue_other) topIssue += (topIssue ? ': ' : '') + esc(s.top_issue_other);
      var involvement = esc(s.involvement || '').replace(/\|/g, ', ');
      var supportLabel = esc(s.decided_support || '—');
      if (supportLabel === 'yes') supportLabel = '✅ Yes';
      else if (supportLabel === 'no') supportLabel = '❌ No';
      else if (supportLabel === 'undecided') supportLabel = '🤷 Undecided';
      var votingPlan = esc(s.voting_plan || '—');
      if (votingPlan === 'yes') votingPlan = '✅ Yes';
      else if (votingPlan === 'no') votingPlan = '❌ No';
      else if (votingPlan === 'unsure') votingPlan = '🤷 Unsure';
      var name = esc(s.voter_name || s.supporter_name || '—');
      var address = esc(s.full_address || s.address || '');
      var phone = esc(s.phone || '—');
      var email = esc(s.email || '—');
      var years = esc(s.years_in_ward || '—');
      var chow = esc(s.chow_rating || '—');
      var submitted = s.created_at ? s.created_at.replace('T',' ').slice(0,16) : '—';
      return '<tr>'+
        '<td style="position:sticky;left:0;background:white;z-index:3;box-shadow:2px 0 4px rgba(0,0,0,0.05);font-weight:600">'+name+'</td>'+
        '<td>'+phone+'</td>'+
        '<td style="font-size:0.85em">'+email+'</td>'+
        '<td style="font-size:0.85em;color:var(--gray-600)">'+address+'</td>'+
        '<td style="max-width:150px;white-space:normal;word-break:break-word">'+topIssue+'</td>'+
        '<td>'+votingPlan+'</td>'+
        '<td>'+supportLabel+'</td>'+
        '<td>'+years+'</td>'+
        '<td>'+chow+'</td>'+
        '<td style="max-width:120px;white-space:normal;word-break:break-word">'+involvement+'</td>'+
        '<td style="font-size:0.78em;color:var(--gray-400);white-space:nowrap">'+submitted+'</td>'+
        '</tr>';
    }).join('');
  } catch(e) {
    tbody.innerHTML = '<tr><td colspan="11" style="text-align:center;color:var(--red);padding:16px">Failed to load surveys</td></tr>';
  }
}

function adminExportSurveys() {
  var a = document.createElement('a');
  a.href = '/api/admin/surveys/export';
  a.download = 'ward25_surveys.csv';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  showAdminToast('📥 Downloading survey CSV...');
}

// ── Changes (Today / Archive) paginated ──
var _changesMode = 'today';
var _changesPage = 1;
var _changesTotalPages = 1;

async function loadChanges(mode) {
  _changesMode = mode || 'today';
  _changesPage = 1;
  // Update tabs
  document.getElementById('changesTabToday').classList.toggle('active', _changesMode === 'today');
  document.getElementById('changesTabArchive').classList.toggle('active', _changesMode === 'archive');
  await changesFetchPage();
}

async function changesFetchPage() {
  var tbody = document.getElementById('recentChanges');
  tbody.innerHTML = '<tr><td colspan="6" class="loading">Loading...</td></tr>';
  var endpoint = _changesMode === 'archive' ? '/api/admin/changes/archive' : '/api/admin/changes';
  try {
    var r = await fetch(endpoint + '?page=' + _changesPage + '&per_page=10');
    var d = await r.json();
    _changesTotalPages = d.total_pages || 1;
    document.getElementById('changesPageInfo').textContent = 'Page ' + d.page + ' of ' + _changesTotalPages;
    document.getElementById('changesTotal').textContent = d.total + ' total changes';
    document.getElementById('btnChangesPrev').disabled = d.page <= 1;
    document.getElementById('btnChangesPrev').style.opacity = d.page <= 1 ? '0.4' : '1';
    document.getElementById('btnChangesNext').disabled = d.page >= _changesTotalPages;
    document.getElementById('btnChangesNext').style.opacity = d.page >= _changesTotalPages ? '0.4' : '1';
    if (!d.changes || d.changes.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--gray-400);padding:20px">No changes ' + (_changesMode === 'today' ? 'today' : 'in archive') + '</td></tr>';
      return;
    }
    tbody.innerHTML = d.changes.map(function(c) {
      var userLabel = c.changed_by ? esc(c.changed_by) : (c.user_id ? '#'+c.user_id : '—');
      var summary = c.changes_summary || '';
      var countBadge = c.field_count > 1 ? ' <span style="font-size:0.7em;color:var(--gray-400)">('+c.field_count+' fields)</span>' : '';
      return '<tr><td style="position:sticky;left:0;background:white;z-index:3;box-shadow:2px 0 4px rgba(0,0,0,0.05);white-space:nowrap">'+esc(c.changed_at)+'</td><td>'+userLabel+'</td><td>'+esc(c.full_name)+'</td><td>'+esc(c.address)+'</td><td style="white-space:nowrap">'+esc(summary)+countBadge+'</td></tr>';
    }).join('');
  } catch(e) {
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--red);padding:16px">Failed to load changes</td></tr>';
  }
}

function changesPrevPage() {
  if (_changesPage > 1) { _changesPage--; changesFetchPage(); }
}

function changesNextPage() {
  if (_changesPage < _changesTotalPages) { _changesPage++; changesFetchPage(); }
}

// ── Stat-card drill-down ──
async function adminDrilldown(type) {
  var tbody = document.getElementById('adminSearchResults');
  document.getElementById('adminSupportFilter').value = '';
  document.getElementById('adminSignFilter').value = '';
  document.getElementById('adminPollFilter').value = '';
  document.getElementById('adminSearchInput').value = '';
  tbody.innerHTML = '<tr><td colspan="10" class="loading">Loading details...</td></tr>';
  document.getElementById('adminSearchInput').scrollIntoView({behavior:'smooth',block:'center'});

  try {
    var r = await fetch('/api/admin/drilldown?type='+encodeURIComponent(type)+'&limit=200', authHeaders());
    var d = await r.json();
    if (!r.ok || d.error) throw new Error(d.error || 'Failed');
    var rows = d.rows || [];
    if (!rows.length) {
      tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;color:var(--gray-400);padding:20px">No records found for '+esc(d.title||'this item')+'</td></tr>';
      return;
    }
    tbody.innerHTML = '<tr style="background:#eff6ff"><td colspan="10" style="font-weight:700;color:var(--blue)">Showing '+rows.length.toLocaleString()+' of '+Number(d.total||rows.length).toLocaleString()+' — '+esc(d.title||'Details')+'</td></tr>' +
      rows.map(function(s){
        var id = s.id || s.supporter_id;
        var addr = [s.street_number, s.street].filter(Boolean).join(' ');
        var badge = getSupportBadgeLabel(s.support_level);
        var when = s.changed_at || s.updated_at || '—';
        var signOrChanges = d.mode === 'changes' ? (s.changes_summary || 'Changed') : (s.sign_request || '—');
        var rowTitle = d.mode === 'changes' ? ' title="'+esc(s.changes_summary||'')+'"' : '';
        return '<tr id="arow-'+id+'"'+rowTitle+'>'+ 
            '<td id="ar-'+id+'-name"><strong style="cursor:pointer" onclick="adminOpenRecord('+id+')" title="Click to open full record view">'+esc(s.full_name||'—')+'</strong></td>'+
          '<td id="ar-'+id+'-addr">'+esc(addr)+(s.apartment?', Apt '+esc(s.apartment):'')+'</td>'+
          '<td id="ar-'+id+'-phone">'+esc(s.phone||'—')+'</td>'+
          '<td id="ar-'+id+'-email" style="font-size:0.85em;color:var(--gray-600)">'+esc(s.email||'—')+'</td>'+
          '<td id="ar-'+id+'-poll" style="font-weight:600">'+(s.poll ? '<a href="/poll_maps/normalized/poll_'+esc(s.poll)+'.png" target="_blank" style="text-decoration:none" title="View map">🗺 '+esc(s.poll)+'</a>' : '—')+'</td>'+
          '<td id="ar-'+id+'-level">'+badge+'</td>'+
          '<td id="ar-'+id+'-sign" style="max-width:260px;white-space:normal;font-size:0.8em">'+esc(signOrChanges)+'</td>'+
          '<td id="ar-'+id+'-updated" style="font-size:0.75em;color:var(--gray-400)">'+esc(when)+'</td>'+
          '<td id="ar-'+id+'-actions" style="white-space:nowrap"><button class="btn-sm" onclick="adminEditRow('+id+')" title="Edit">✏️</button> <button class="btn-sm" onclick="adminToggleHistory('+id+')" title="View change history">📜</button></td>'+
          '</tr>';
      }).join('');
  } catch(e) {
    tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;color:var(--red);padding:16px">Failed to load details: '+esc(e.message||e)+'</td></tr>';
  }
}

// ── Drill-down from team dashboard ──
function drillSupportLevel(level) {
  var l = level.toLowerCase();
  var filterVal = '';
  if (l === 'supporter') filterVal = 'Supporter';
  else if (l === 'neutral') filterVal = 'Neutral';
  else if (l === 'non-supporter' || l === 'non supporter') filterVal = 'Non-Supporter';
  document.getElementById('adminSupportFilter').value = filterVal;
  document.getElementById('adminSignFilter').value = '';
  document.getElementById('adminPollFilter').value = '';
  document.getElementById('adminSearchInput').value = '';
  document.getElementById('adminSearchInput').focus();
  adminSearch();
  document.getElementById('adminSearchInput').scrollIntoView({behavior:'smooth',block:'center'});
}

function drillUser(username) {
  document.getElementById('adminSupportFilter').value = '';
  document.getElementById('adminSignFilter').value = '';
  document.getElementById('adminPollFilter').value = '';
  document.getElementById('adminSearchInput').value = username;
  document.getElementById('adminSearchInput').focus();
  adminSearch();
  document.getElementById('adminSearchInput').scrollIntoView({behavior:'smooth',block:'center'});
}

function drillPoll(pollNum) {
  document.getElementById('adminSupportFilter').value = '';
  document.getElementById('adminSignFilter').value = '';
  document.getElementById('adminPollFilter').value = pollNum;
  document.getElementById('adminSearchInput').value = '';
  adminSearch();
  document.getElementById('adminSearchInput').scrollIntoView({behavior:'smooth',block:'center'});
}

function clearAdminFilters() {
  document.getElementById('adminSupportFilter').value = '';
  document.getElementById('adminSignFilter').value = '';
  document.getElementById('adminPollFilter').value = '';
  document.getElementById('adminSearchInput').value = '';
  document.getElementById('adminSearchInput').focus();
  document.getElementById('adminSearchResults').innerHTML = '<tr><td colspan="10" style="text-align:center;color:var(--gray-400);padding:20px">Filters cleared — enter a search or select filters</td></tr>';
  document.getElementById('adminNameFilter').value = '';
  document.getElementById('adminNameFilterRow').style.display = 'none';
  _lastAdminResults = [];
}

// ── Name sub-filter: filter admin results client-side ──
function adminFilterByName() {
  var q = document.getElementById('adminNameFilter').value.trim().toLowerCase();
  var allResults = _lastAdminResults || [];
  var tbody = document.getElementById('adminSearchResults');
  var countEl = document.getElementById('adminNameFilterCount');

  if (!q) {
    // Show all results
    renderAdminResults(allResults);
    countEl.textContent = '';
    return;
  }

  var filtered = allResults.filter(function(s) {
    var name = (s.full_name || '').toLowerCase();
    var first = (s.first_name || '').toLowerCase();
    var last = (s.last_name || '').toLowerCase();
    return name.indexOf(q) > -1 || first.indexOf(q) > -1 || last.indexOf(q) > -1;
  });

  countEl.textContent = filtered.length + ' of ' + allResults.length + ' match "' + document.getElementById('adminNameFilter').value.trim() + '"';
  renderAdminResults(filtered);
}

function renderAdminResults(data) {
  var tbody = document.getElementById('adminSearchResults');
  if (!data || data.length === 0) {
    tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;color:var(--gray-400);padding:20px">No names match the filter</td></tr>';
    return;
  }
  tbody.innerHTML = data.map(function(s){
    var addr = [s.street_number, s.street].filter(Boolean).join(' ');
    var badge = getSupportBadgeLabel(s.support_level);
    var rowId = 'arow-'+s.id;
    return '<tr id="'+rowId+'">'+
      '<td id="ar-'+s.id+'-name"><strong style="cursor:pointer" onclick="adminOpenRecord('+s.id+')" title="Click to open full record view">'+esc(s.full_name||'—')+'</strong></td>'+
      '<td id="ar-'+s.id+'-addr">'+esc(addr)+(s.apartment?', Apt '+esc(s.apartment):'')+'</td>'+
      '<td id="ar-'+s.id+'-phone">'+esc(s.phone||'—')+'</td>'+
      '<td id="ar-'+s.id+'-email" style="font-size:0.85em;color:var(--gray-600)">'+esc(s.email||'—')+'</td>'+
      '<td id="ar-'+s.id+'-poll" style="font-weight:600"><a href="/poll_maps/normalized/poll_'+esc(s.poll)+'.png" target="_blank" style="text-decoration:none" title="View map" class="'+getPollBadgeClass(s.poll)+'" style="padding:1px 8px;border-radius:8px;font-size:0.85em">🗺 '+(s.poll||'—')+'</a></td>'+
      '<td id="ar-'+s.id+'-level">'+badge+'</td>'+
      '<td id="ar-'+s.id+'-sign">'+esc(s.sign_request||'—')+'</td>'+
      '<td id="ar-'+s.id+'-notes" style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:0.85em;color:var(--gray-600)">'+esc(s.notes||'—')+'</td>'+
      '<td id="ar-'+s.id+'-updated" style="font-size:0.75em;color:var(--gray-400)">'+esc(s.updated_at||'—')+'</td>'+
      '<td id="ar-'+s.id+'-actions" style="white-space:nowrap"><button class="btn-sm" onclick="adminEditRow('+s.id+')" title="Edit">✏️</button> <button class="btn-sm" onclick="adminToggleHistory('+s.id+')" title="View change history">📜</button><br><span id="ar-'+s.id+'-status" style="font-size:0.7em;color:var(--amber);margin-top:2px;display:inline-block"></span></td>'+
      '</tr>';
  }).join('');
}

// ── Canvass by Poll ──
var canvassData = null;
var canvassAllRecords = [];
var canvassPage = 1;
var CANVASS_PAGE_SIZE = 10;

async function loadCanvassList(streetFilter) {
  var poll = document.getElementById('canvassPollSelect').value;
  if (!poll) return;
  
  var tbody = document.getElementById('canvassListBody');
  tbody.innerHTML = '<tr><td colspan="7" class="loading">Loading route...</td></tr>';
  document.getElementById('canvassMapDataRow').style.display = 'flex';
  document.getElementById('canvassAssignRow').style.display = 'flex';
  
  // Show map
  document.getElementById('canvassMapImg').src = '/poll_maps/normalized/poll_'+poll+'.png';
  document.getElementById('canvassMapLink').href = '/poll_maps/normalized/poll_'+poll+'.png';
  
  try {
    var url = '/api/poll-canvass?poll='+encodeURIComponent(poll);
    if (streetFilter) url += '&street='+encodeURIComponent(streetFilter);
    var r = await fetch(url);
    var d = await r.json();
    canvassData = d;
    canvassAllRecords = d.records || [];
    canvassPage = 1;
    
    renderCanvassTable();
    document.getElementById('canvassSummary').textContent = d.count + ' addresses' + (streetFilter ? ' on ' + streetFilter : ' · sorted by street');
    document.getElementById('btnCanvassCSV').style.display = 'inline-block';
    document.getElementById('btnCanvassPrint').style.display = 'inline-block';
    
    // Load canvasser list for assignment
    loadCanvasserUsers();
  } catch(e) {
    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--red)">Error loading route</td></tr>';
  }
}

function onCanvassPollChange() {
  var poll = document.getElementById('canvassPollSelect').value;
  if (poll) {
    document.getElementById('canvassMapImg').src = '/poll_maps/normalized/poll_'+poll+'.png';
    document.getElementById('canvassMapLink').href = '/poll_maps/normalized/poll_'+poll+'.png';
    document.getElementById('canvassMapDataRow').style.display = 'flex';
    document.getElementById('canvassPagination').style.display = 'none';
    loadPollStreets(poll);
  }
}

async function loadPollStreets(poll) {
  try {
    var r = await fetch('/api/poll-streets?poll='+encodeURIComponent(poll));
    var d = await r.json();
    var sel = document.getElementById('canvassStreetFilter');
    sel.innerHTML = '<option value="">— All Streets —</option>';
    (d.streets||[]).forEach(function(s) {
      if (s === '103 Bathgate Dr' || s === '32 CHARLES TUPPER DR') return;
      sel.innerHTML += '<option value="'+esc(s)+'">'+esc(s)+'</option>';
    });
  } catch(e) { console.error('streets:', e); }
}

function filterCanvassList() {
  var filter = document.getElementById('canvassStreetFilter').value;
  loadCanvassList(filter);
}

function renderCanvassTable() {
  var tbody = document.getElementById('canvassListBody');
  var pagination = document.getElementById('canvassPagination');
  var totalRecords = canvassAllRecords.length;
  
  if (totalRecords === 0) {
    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--gray-400)">No matching records</td></tr>';
    pagination.style.display = 'none';
    return;
  }
  
  var totalPages = Math.ceil(totalRecords / CANVASS_PAGE_SIZE);
  if (canvassPage > totalPages) canvassPage = totalPages;
  if (canvassPage < 1) canvassPage = 1;
  
  var start = (canvassPage - 1) * CANVASS_PAGE_SIZE;
  var end = Math.min(start + CANVASS_PAGE_SIZE, totalRecords);
  var pageRecords = canvassAllRecords.slice(start, end);
  
  tbody.innerHTML = pageRecords.map(function(s, i){
    var idx = start + i + 1;
    var addr = [s.street_number, s.street].filter(Boolean).join(' ');
    if (s.apartment) addr += ' Apt '+s.apartment;
    var supportBadge = getSupportBadgeLabel(s.support_level);
    var rowStyle = s.sign_request === 'Requested' ? 'background:#fef3c7' : '';
    return '<tr style="'+rowStyle+'">'+
      '<td style="font-size:0.75em;color:var(--gray-400)">'+idx+'</td>'+
      '<td><strong>'+esc(addr)+'</strong></td>'+
      '<td>'+esc(s.full_name||'—')+'</td>'+
      '<td>'+esc(s.phone||'—')+'</td>'+
      '<td>'+supportBadge+'</td>'+
      '<td>'+esc(s.sign_request||'—')+'</td>'+
      '<td style="font-size:0.8em;max-width:200px">'+esc(s.notes||'')+'</td>'+
      '</tr>';
  }).join('');
  
  // Update summary with page range
  document.getElementById('canvassSummary').textContent = 
    'Showing '+(start+1)+'–'+end+' of '+totalRecords+' addresses · sorted by street';
  
  // Update pagination controls
  document.getElementById('canvassPageInfo').textContent = 'Page '+canvassPage+' of '+totalPages+' ('+totalRecords+' records)';
  document.getElementById('btnCanvassPrev').disabled = canvassPage <= 1;
  document.getElementById('btnCanvassNext').disabled = canvassPage >= totalPages;
  pagination.style.display = totalPages > 1 ? 'flex' : 'none';
}

function canvassPrevPage() {
  if (canvassPage > 1) { canvassPage--; renderCanvassTable(); }
}

function canvassNextPage() {
  var totalPages = Math.ceil(canvassAllRecords.length / CANVASS_PAGE_SIZE);
  if (canvassPage < totalPages) { canvassPage++; renderCanvassTable(); }
}

async function loadCanvasserUsers() {
  try {
    var r = await fetch('/api/admin/users', {
      headers: {'Authorization': 'Bearer ' + (token || '')}
    });
    var d = await r.json();
    var sel = document.getElementById('canvassAssignUser');
    sel.innerHTML = '<option value="">— Select canvasser —</option>';
    (d.users||[]).forEach(function(u) {
      if (u.role === 'canvasser') {
        sel.innerHTML += '<option value="'+esc(u.username)+'">'+esc(u.display_name||u.username)+'</option>';
      }
    });
  } catch(e) {}
}

async function assignCanvassWalk() {
  var poll = document.getElementById('canvassPollSelect').value;
  var canvasser = document.getElementById('canvassAssignUser').value;
  if (!poll || !canvasser) {
    document.getElementById('canvassAssignMsg').textContent = '⚠ Select poll and canvasser';
    return;
  }
  var streets = document.getElementById('canvassStreetFilter').value || '';
  
  try {
    var r = await fetch('/api/canvass/assign', {
      method: 'POST',
      headers: {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (token || '')},
      body: JSON.stringify({poll: poll, canvasser: canvasser, streets: streets})
    });
    var d = await r.json();
    if (d.success) {
      document.getElementById('canvassAssignMsg').textContent = '✅ Walk pushed to '+canvasser+'!';
      loadCanvassAssignments();
    } else {
      document.getElementById('canvassAssignMsg').textContent = '❌ '+(d.error||'Failed');
    }
  } catch(e) {
    document.getElementById('canvassAssignMsg').textContent = '❌ Error assigning walk';
  }
}

async function loadCanvassAssignments() {
  try {
    var r = await fetch('/api/canvass/report', {
      headers: {'Authorization': 'Bearer ' + (token || '')}
    });
    var d = await r.json();
    var tbody = document.getElementById('canvassAssignmentsBody');
    if (!d.recent || d.recent.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--gray-400)">No assignments yet</td></tr>';
      return;
    }
    tbody.innerHTML = d.recent.map(function(a) {
      var statusColor = a.status === 'completed' ? 'var(--green)' : 'var(--orange)';
      var statusIcon = a.status === 'completed' ? '✅' : '⏳';
      return '<tr>'+
        '<td><strong>Poll '+esc(a.poll)+'</strong></td>'+
        '<td>'+esc(a.assigned_to)+'</td>'+
        '<td>'+esc(a.streets||'All')+'</td>'+
        '<td style="color:'+statusColor+';font-weight:600">'+statusIcon+' '+esc(a.status)+'</td>'+
        '<td style="font-size:0.8em">'+esc(a.created_at||'')+'</td>'+
        '<td style="font-size:0.8em">'+esc(a.completed_at||'—')+'</td>'+
        '<td><button onclick="deleteAssignment('+a.id+')" style="font-size:0.7em;padding:2px 8px;background:var(--red);color:white;border:none;border-radius:4px;cursor:pointer">✕</button></td>'+
        '</tr>';
    }).join('');
  } catch(e) { console.error('load assignments:', e); }
}

async function deleteAssignment(id) {
  if (!confirm('Delete this assignment?')) return;
  try {
    await fetch('/api/canvass/assignment/'+id, {
      method: 'DELETE',
      headers: {'Authorization': 'Bearer ' + (token || '')}
    });
    loadCanvassAssignments();
  } catch(e) {}
}

// ── Support Trends by Poll ──
async function loadSupportTrends(days) {
  // Update toggle buttons
  document.querySelectorAll('.chart-toggle[id^=trend]').forEach(function(b){ b.classList.remove('active'); });
  var btn = document.getElementById('trend'+days);
  if (btn) btn.classList.add('active');
  document.getElementById('trendRangeLabel').textContent = 'Last '+days+' days';
  
  try {
    var r = await fetch('/api/poll-support-trends?days='+days);
    var d = await r.json();
    var tbody = document.getElementById('supportTrendsBody');
    
    if (!d.polls || d.polls.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:var(--gray-400)">No support level changes in this period</td></tr>';
      return;
    }
    
    // Keep this summary table to 4 fixed columns so every poll fits on one row.
    // The 7/14/30 buttons change the period; the table shows totals for that period,
    // not one column per day (which caused horizontal toggling/scrolling).
    var headerRow = document.querySelector('#supportTrendsBody').closest('table').querySelector('thead tr');
    headerRow.innerHTML = '<th style="width:22%">Poll</th><th style="width:26%">Gained</th><th style="width:26%">Lost</th><th style="width:26%">Net</th>';

    var totalGained = 0, totalLost = 0;
    tbody.innerHTML = d.polls.map(function(poll) {
      var gained = 0, lost = 0;
      d.days.forEach(function(day) {
        var t = (d.trends[day] && d.trends[day][poll]) || {gained:0, lost:0};
        gained += Number(t.gained || 0);
        lost += Number(t.lost || 0);
      });
      totalGained += gained;
      totalLost += lost;
      var totalNet = gained - lost;
      var netClass = totalNet > 0 ? 'color:var(--green);font-weight:700' : totalNet < 0 ? 'color:var(--red);font-weight:700' : 'color:var(--gray-400)';
      var netSign = totalNet > 0 ? '+' : '';
      var colorClass = getPollColorClass(String(poll));
      return '<tr class="'+colorClass+'">'+
        '<td style="font-weight:700;white-space:nowrap">'+poll+'</td>'+
        '<td style="text-align:center;color:var(--green);font-weight:600">+'+gained+'</td>'+
        '<td style="text-align:center;color:var(--red);font-weight:600">−'+lost+'</td>'+
        '<td style="text-align:center;'+netClass+'">'+netSign+totalNet+'</td>'+
        '</tr>';
    }).join('');

    var totalNet = totalGained - totalLost;
    var tnClass = totalNet > 0 ? 'color:var(--green);font-weight:700' : totalNet < 0 ? 'color:var(--red);font-weight:700' : 'color:var(--gray-700);font-weight:700';
    tbody.innerHTML += '<tr style="border-top:2px solid var(--gray-300);font-weight:700;background:var(--gray-50)">'+
      '<td>TOTAL</td>'+
      '<td style="text-align:center;color:var(--green)">+'+totalGained+'</td>'+
      '<td style="text-align:center;color:var(--red)">−'+totalLost+'</td>'+
      '<td style="text-align:center;'+tnClass+'">'+(totalNet>0?'+':'')+totalNet+'</td></tr>';
  } catch(e) { console.error('support trends:', e); }
}

async function resetPassword(uid, username) {
  var pw = prompt('Enter new password for '+username+':');
  if (!pw) return;
  try {
    var r = await fetch('/api/admin/users/'+uid+'/reset-password', {
      method:'POST',
      headers:{'Content-Type':'application/json', 'Authorization':'Bearer '+token},
      body:JSON.stringify({password:pw})
    });
    var d = await r.json();
    if (d.success) alert('✅ Password reset for '+username);
    else alert('❌ Failed: '+(d.error||'error'));
  } catch(e) { alert('❌ Network error'); }
}

// ── Helpers ──
function formatSize(b) {
  if (b < 1024) return b + ' B';
  if (b < 1048576) return (b/1024).toFixed(1)+' KB';
  return (b/1048576).toFixed(1)+' MB';
}
function timeAgo(ms) {
  var diff = Date.now() - ms;
  var mins = Math.floor(diff/60000);
  if (mins < 1) return 'Just now';
  if (mins < 60) return mins+'m ago';
  var hrs = Math.floor(mins/60);
  if (hrs < 24) return hrs+'h ago';
  return Math.floor(hrs/24)+'d ago';
}
function esc(s) { if(!s) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

var _adminToastTimer;
function showAdminToast(msg) {
  var t = document.getElementById('adminToast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'adminToast';
    t.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--gray-900);color:white;padding:10px 24px;border-radius:10px;font-size:0.88em;font-weight:600;z-index:9999;opacity:0;transition:opacity 0.3s;pointer-events:none;white-space:nowrap;box-shadow:0 4px 16px rgba(0,0,0,0.2)';
    document.body.appendChild(t);
  }
  t.textContent = msg;
  t.style.opacity = '1';
  clearTimeout(_adminToastTimer);
  _adminToastTimer = setTimeout(function(){ t.style.opacity = '0'; }, 2500);
}

// Download DB with auth token
function downloadDB(e) {
  e.preventDefault();
  if (!token) { alert('Not authenticated'); return; }
  window.location.href = '/api/admin/export-db?token=' + encodeURIComponent(token);
}

// Enter key on login
document.getElementById('loginPass').addEventListener('keydown', function(e){ if(e.key==='Enter') doLogin(); });
// Enter key on admin search
document.getElementById('adminSearchInput').addEventListener('keydown', function(e){ if(e.key==='Enter') adminSearch(); });
document.getElementById('adminSearchInput').addEventListener('input', function(){ clearTimeout(window._adminSearchTimer); window._adminSearchTimer = setTimeout(adminSearch, 300); });
// Click delegation for team dashboard drill-down
document.addEventListener('click', function(e) {
  var row = e.target.closest('.clickable-row');
  if (!row) return;
  var drill = row.getAttribute('data-drill');
  var val = row.getAttribute('data-value');
  if (drill === 'level') drillSupportLevel(val);
  else if (drill === 'user') drillUser(val);
  else if (drill === 'poll') drillPoll(val);
});

// Keyboard arrow keys for canvass pagination
document.addEventListener('keydown', function(e) {
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;
  if (document.getElementById('canvassPagination').style.display === 'flex') {
    if (e.key === 'ArrowLeft') { e.preventDefault(); canvassPrevPage(); }
    else if (e.key === 'ArrowRight') { e.preventDefault(); canvassNextPage(); }
  }
});
</script>
</body>
</html>
