      <span>🏆 Canvasser Leaderboard</span>
      <span style="font-size:0.7em;color:var(--gray-400)" id="csRangeLabel">Today</span>
    </div>
    <div style="display:flex;gap:8px;align-items:center;margin-bottom:8px;flex-wrap:wrap">
      <button class="chart-toggle active" id="csDaily" onclick="loadCanvasserStats('daily')">Today</button>
      <button class="chart-toggle" id="csWeek" onclick="loadCanvasserStats('week')">This Week</button>
      <button class="chart-toggle" id="csMonth" onclick="loadCanvasserStats('month')">This Month</button>
      <button class="chart-toggle" id="csTotal" onclick="loadCanvasserStats('total')">All Time</button>
      <span style="font-size:0.75em;color:var(--gray-400);margin:0 4px">or</span>
      <input type="date" id="csStart" style="padding:5px 8px;border:1px solid var(--gray-200);border-radius:6px;font-size:0.8em;font-family:inherit" onchange="loadCanvasserStats('custom')">
      <span style="font-size:0.75em;color:var(--gray-400)">to</span>
      <input type="date" id="csEnd" style="padding:5px 8px;border:1px solid var(--gray-200);border-radius:6px;font-size:0.8em;font-family:inherit" onchange="loadCanvasserStats('custom')">
    </div>
    <div style="margin-bottom:8px">
      <input type="text" id="csSearch" placeholder="🔍 Search canvassers..." style="width:100%;max-width:300px;padding:8px 12px;border:1px solid var(--gray-200);border-radius:8px;font-size:0.85em;font-family:inherit" oninput="filterCanvasserStats()">
    </div>
    </div>
    <div class="table-wrap table-scroll" style="margin-bottom:12px">
      <table>
        <thead class="leaderboard-thead">
          <tr>
            <th style="width:50px">#</th>
            <th style="cursor:pointer;user-select:none" onclick="sortCanvasserStats('name')">Canvasser <span class="sort-arrow" id="sortArrow_name"></span></th>
            <th style="cursor:pointer;user-select:none;text-align:right" onclick="sortCanvasserStats('changes')">Changes <span class="sort-arrow" id="sortArrow_changes"></span></th>
            <th style="cursor:pointer;user-select:none;text-align:right" onclick="sortCanvasserStats('supporters')">Supporters <span class="sort-arrow" id="sortArrow_supporters"></span></th>
            <th style="cursor:pointer;user-select:none;text-align:right" onclick="sortCanvasserStats('signs')">Signs Req. <span class="sort-arrow" id="sortArrow_signs"></span></th>
            <th style="cursor:pointer;user-select:none;text-align:right" onclick="sortCanvasserStats('surveys')">Surveys <span class="sort-arrow" id="sortArrow_surveys"></span></th>
          </tr>
        </thead>
        <tbody id="canvasserStatsBody"><tr><td colspan="6" class="loading">Loading...</td></tr></tbody>
      </table>
    </div>

    <div class="section-title">💾 Backups</div>
