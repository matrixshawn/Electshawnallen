          <button id="btnCanvassPrev" onclick="canvassPrevPage()" style="padding:5px 14px;border:1px solid var(--gray-200);background:white;border-radius:6px;cursor:pointer;font-family:inherit;font-weight:600">◀ Prev</button>
          <span id="canvassPageInfo" style="color:var(--gray-700);font-weight:500">Page 1 of 1</span>
          <button id="btnCanvassNext" onclick="canvassNextPage()" style="padding:5px 14px;border:1px solid var(--gray-200);background:white;border-radius:6px;cursor:pointer;font-family:inherit;font-weight:600">Next ▶</button>
        </div>
      </div>
    </div>

    <!-- Active Assignments Table -->
    <div class="section-title" style="margin-top:16px;font-size:0.9em">📋 Active Assignments</div>
